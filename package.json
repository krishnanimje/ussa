{
  "name": "brandon-urzua-luxury-estates",
  "private": true,
  "version": "1.0.0",
  "description": "Brandon Urzua Luxury Real Estate Platform, Interactive Google Maps, AI Concierge & CMS",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts --dev",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --outfile=dist-server/server.js --packages=external",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --outfile=dist-server/server.js --packages=external",
    "start": "node dist-server/server.js",
    "start:ts": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "supabase:sync": "tsx scripts/sync-supabase.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
