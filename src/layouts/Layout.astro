---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import AnalyticsTracker from '../components/AnalyticsTracker.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  jsonLd?: string;
  lang?: string;
  hreflangEn?: string;
  hreflangEs?: string;
  noindex?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  video?: {
    name: string;
    description: string;
    thumbnailUrl: string;
    uploadDate: string;
    contentUrl?: string;
    embedUrl?: string;
  };
}

const { 
  title, 
  description, 
  image, 
  canonicalUrl, 
  type, 
  publishedTime, 
  jsonLd,
  lang = 'en',
  hreflangEn,
  hreflangEs,
  noindex = false,
  breadcrumbs,
  video
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead 
      title={title}
      description={description}
      image={image}
      canonicalUrl={canonicalUrl}
      type={type}
      publishedTime={publishedTime}
      jsonLd={jsonLd}
      hreflangEn={hreflangEn}
      hreflangEs={hreflangEs}
      noindex={noindex}
      breadcrumbs={breadcrumbs}
      video={video}
    />
    <ClientRouter />
  </head>
  <body>
    <a href="#mainContent" class="skip-link">Skip to main content</a>
    <Header />
    <main id="mainContent">
      <slot />
    </main>
    <Footer />
    <AnalyticsTracker />
    <CookieConsent />
  </body>
</html>
