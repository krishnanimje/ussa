---
import Layout from '../../layouts/Layout.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LeadCaptureForm from '../../components/LeadCaptureForm.astro';
import { getNeighborhoodBySlug, getProperties } from '../../lib/store';
import { formatCurrency } from '../../lib/mortgage';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/neighborhoods');

const neighborhood = await getNeighborhoodBySlug(slug);
if (!neighborhood) return Astro.redirect('/404');

const allProperties = await getProperties();
const neighborhoodProperties = allProperties.filter(
  p => p.neighborhood.toLowerCase() === neighborhood.name.toLowerCase()
);

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Neighborhoods', url: '/neighborhoods' },
  { name: neighborhood.name, url: `/neighborhoods/${neighborhood.slug}` }
];
---

<Layout 
  title={`${neighborhood.name} San Diego — Real Estate & Community Guide`}
  description={`Comprehensive living and real estate guide to ${neighborhood.name}, San Diego. Median home price ${formatCurrency(neighborhood.median_home_price)}, neighborhood highlights, and active listings.`}
  image={neighborhood.hero_image}
  canonicalUrl={`/neighborhoods/${neighborhood.slug}`}
  breadcrumbs={breadcrumbItems}
>
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Hero Section -->
  <section class="section section-secondary">
    <div class="container">
      <div class="hood-hero-grid">
        <div>
          <span class="section-eyebrow">{neighborhood.vibe}</span>
          <h1 style="font-size: clamp(2.5rem, 5vw, 3.8rem); margin-bottom: 0.5rem;">{neighborhood.name}</h1>
          <p class="lead" style="color: var(--color-gold-700); font-weight: 600; margin-bottom: 1.25rem;">{neighborhood.tagline}</p>
          <p class="lead">{neighborhood.summary}</p>
          
          <div class="hood-meta-chips">
            <div class="chip">
              <span class="chip-val">{formatCurrency(neighborhood.median_home_price)}</span>
              <span class="chip-lbl">Median Price</span>
            </div>
            <div class="chip">
              <span class="chip-val">~{neighborhood.commute_downtown_mins || 15} Mins</span>
              <span class="chip-lbl">Commute to Downtown</span>
            </div>
            <div class="chip">
              <span class="chip-val">{neighborhoodProperties.length} Active</span>
              <span class="chip-lbl">Homes Available</span>
            </div>
          </div>
        </div>

        <div class="hood-hero-img-box">
          <img 
            src={neighborhood.hero_image} 
            alt={`${neighborhood.name} San Diego community highlights and architectural landscape`} 
            width="600" 
            height="400" 
            loading="eager" 
            fetchpriority="high" 
            decoding="async" 
            class="hood-banner-img" 
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Neighborhood Highlights -->
  <section class="section">
    <div class="container container-narrow">
      <div class="card" style="padding: 2.75rem; background: #ffffff;">
        <h2 style="font-size: 1.85rem; margin-bottom: 1.25rem;">Why Residents Love {neighborhood.name}</h2>
        <div class="highlights-checklist">
          {neighborhood.highlights.map(h => (
            <div class="h-item">
              <span class="h-bullet">★</span>
              <span class="h-text">{h}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Active Homes in this Neighborhood -->
  <section class="section section-secondary">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">CURRENT INVENTORY</span>
        <h2>Homes for Sale in {neighborhood.name}</h2>
        <p class="lead">Verified active listings represented by Edgar Valle and Full Circle Group.</p>
      </div>

      {neighborhoodProperties.length === 0 ? (
        <div class="card" style="padding: 3rem; text-align: center; max-width: 600px; margin: 0 auto;">
          <h3>No Active Listings Currently in {neighborhood.name}</h3>
          <p>Homes in this neighborhood sell quickly. Join Edgar's private notification list for off-market and upcoming properties in {neighborhood.name}.</p>
          <a href="#hoodAlertForm" class="btn btn-gold">Get Notified of New Listings</a>
        </div>
      ) : (
        <div class="grid-3">
          {neighborhoodProperties.map(p => (
            <PropertyCard property={p} />
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Neighborhood Alert & Consultation Form -->
  <section class="section" id="hoodAlertForm">
    <div class="container container-narrow">
      <LeadCaptureForm 
        leadType="general_contact"
        formTitle={`Interested in Living in ${neighborhood.name}?`}
        buttonText={`Schedule a ${neighborhood.name} Neighborhood Tour`}
      />
    </div>
  </section>
</Layout>

<style>
  .hood-hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (max-width: 900px) {
    .hood-hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .hood-meta-chips {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }

  .chip {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1.25rem;
    box-shadow: var(--shadow-xs);
  }

  .chip-val {
    display: block;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-gold-700);
  }

  .chip-lbl {
    font-size: 0.72rem;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--text-muted);
  }

  .hood-hero-img-box {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background: var(--color-navy-950);
  }

  .hood-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .highlights-checklist {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .h-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1.05rem;
  }

  .h-bullet {
    color: var(--color-gold-600);
    font-size: 1.2rem;
    line-height: 1;
  }

  .h-text {
    color: var(--text-secondary);
  }
</style>
