---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadCaptureForm from '../components/LeadCaptureForm.astro';
import { getOpenHouses } from '../lib/store';
import { formatCurrency } from '../lib/mortgage';

const openHouses = await getOpenHouses();

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Weekend Open Houses', url: '/open-houses' }
];
---

<Layout 
  title="San Diego Weekend Open Houses — Hosted by Edgar Valle"
  description="Tour upcoming weekend open houses in North Park, Pacific Beach, and Chula Vista hosted by Realtor Edgar Valle. RSVP for private walkthroughs and refreshments."
  canonicalUrl="/open-houses"
  hreflangEn="/open-houses"
  hreflangEs="/es/casas-abiertas"
  breadcrumbs={breadcrumbItems}
>
  <Breadcrumbs items={breadcrumbItems} />
  <!-- Hero -->
  <section class="section section-secondary">
    <div class="container container-narrow text-center">
      <span class="section-eyebrow">WEEKEND TOUR SCHEDULE</span>
      <h1>San Diego Open Houses</h1>
      <p class="lead" style="margin: 0 auto 2rem auto;">
        Join Edgar Valle this weekend for in-person property walkthroughs, architectural inspections, and neighborhood discussions. Artisan refreshments provided.
      </p>
    </div>
  </section>

  <!-- Open Houses List -->
  <section class="section">
    <div class="container">
      {openHouses.length === 0 ? (
        <div class="card" style="padding: 3rem; text-align: center; max-width: 600px; margin: 0 auto;">
          <h3>No Open Houses Scheduled This Weekend</h3>
          <p>Private showings are available 7 days a week. Contact Edgar directly to book a private tour.</p>
          <a href="/contact" class="btn btn-gold">Request Private Showing</a>
        </div>
      ) : (
        <div class="open-houses-list">
          {openHouses.map(oh => {
            const p = oh.property;
            if (!p) return null;
            return (
              <div class="card oh-item-card">
                <div class="oh-media-col">
                  <img src={p.primary_image} alt={p.title} width="380" height="250" class="oh-img" />
                  <div class="oh-badge-float">
                    <span class="badge badge-emerald">Open House</span>
                  </div>
                </div>

                <div class="oh-info-col">
                  <div class="oh-datetime">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <strong>Upcoming Saturday &amp; Sunday:</strong> 1:00 PM – 4:00 PM
                  </div>

                  <h3 class="oh-title"><a href={`/properties/${p.slug}`}>{p.title}</a></h3>
                  <p class="oh-address">{p.address_street}, {p.neighborhood}, {p.address_city} {p.address_zip}</p>

                  <div class="oh-specs-row">
                    <span><strong>{formatCurrency(p.price)}</strong></span>
                    <span>•</span>
                    <span>{p.bedrooms} Beds</span>
                    <span>•</span>
                    <span>{p.bathrooms} Baths</span>
                    <span>•</span>
                    <span>{p.square_feet.toLocaleString()} Sq Ft</span>
                  </div>

                  <p class="oh-notes">{oh.special_instructions}</p>

                  <div class="oh-action-row">
                    <a href={`/properties/${p.slug}`} class="btn btn-outline btn-sm">View Property Details</a>
                    <a href={`/contact?property=${p.slug}&type=open_house_rsvp`} class="btn btn-gold btn-sm">RSVP / Guestlist</a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <!-- RSVP Section -->
  <section class="section section-secondary">
    <div class="container container-narrow">
      <LeadCaptureForm 
        leadType="open_house_rsvp"
        formTitle="RSVP for Weekend Open House Tours"
        buttonText="Confirm My Attendance"
      />
    </div>
  </section>
</Layout>

<style>
  .open-houses-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 980px;
    margin: 0 auto;
  }

  .oh-item-card {
    display: grid;
    grid-template-columns: 380px 1fr;
    background: #ffffff;
    overflow: hidden;
  }

  @media (max-width: 800px) {
    .oh-item-card {
      grid-template-columns: 1fr;
    }
  }

  .oh-media-col {
    position: relative;
    background: var(--color-navy-950);
  }

  .oh-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .oh-badge-float {
    position: absolute;
    top: 15px;
    left: 15px;
  }

  .oh-info-col {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
  }

  .oh-datetime {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-gold-700);
    margin-bottom: 0.75rem;
  }

  .oh-title {
    font-size: 1.45rem;
    margin-bottom: 0.35rem;
  }

  .oh-title a {
    color: var(--text-primary);
  }

  .oh-title a:hover {
    color: var(--color-gold-700);
  }

  .oh-address {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
  }

  .oh-specs-row {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    font-size: 0.92rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .oh-specs-row strong {
    color: var(--color-navy-950);
    font-size: 1.15rem;
  }

  .oh-notes {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .oh-action-row {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    flex-wrap: wrap;
  }
</style>
