---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Cookie Policy', url: '/cookie-policy' }
];
---

<Layout 
  title="Cookie Policy"
  description="Cookie Policy explaining essential and performance cookies used on the Edgar Valle Real Estate platform."
  canonicalUrl="/cookie-policy"
  breadcrumbs={breadcrumbItems}
>
  <Breadcrumbs items={breadcrumbItems} />
  <div class="section">
    <div class="container container-narrow">
      <div class="section-header" style="text-align: left; margin-bottom: 2.5rem;">
        <span class="section-eyebrow">DATA PRACTICES</span>
        <h1>Cookie Policy</h1>
        <p class="lead">Understanding how cookies and local storage enhance your real estate search experience.</p>
      </div>

      <div class="card" style="padding: 2.5rem;">
        <h3>1. What Are Cookies?</h3>
        <p>Cookies are small text files placed on your browser or device when you visit websites. They remember your preferences, like language choice and search filter states.</p>

        <h3 style="margin-top: 1.5rem;">2. How We Use Cookies</h3>
        <p>We use minimal, privacy-respecting cookies:</p>
        <ul style="margin: 0 0 1.25rem 1.5rem; color: var(--text-secondary);">
          <li><strong>Essential Cookies:</strong> Required for secure session verification in our administrative portal.</li>
          <li><strong>Preference Cookies:</strong> Retain your language preference (English/Spanish) and property filter preferences.</li>
          <li><strong>Analytics:</strong> Anonymous aggregate traffic telemetry to understand which San Diego neighborhood guides are most helpful.</li>
        </ul>

        <h3 style="margin-top: 1.5rem;">3. Managing Your Cookies</h3>
        <p>You can adjust cookie settings or block cookies entirely in your browser settings (Chrome, Safari, Firefox, Edge). Blocking all cookies may affect admin login sessions.</p>
      </div>
    </div>
  </div>
</Layout>
