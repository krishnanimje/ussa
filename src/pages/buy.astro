---
import Layout from '../layouts/Layout.astro';
import LeadCaptureForm from '../components/LeadCaptureForm.astro';
---

<Layout 
  title="Buy a Home in San Diego — Complete Buyer's Guide & Representation"
  description="Navigate the San Diego real estate market with Edgar Valle | Realtor. Access off-market listings, winning offer strategies, and full buyer representation."
>
  <!-- Hero -->
  <section class="section section-secondary">
    <div class="container container-narrow text-center">
      <span class="section-eyebrow">BUYER REPRESENTATION</span>
      <h1>Buying a Home in San Diego</h1>
      <p class="lead" style="margin: 0 auto 2rem auto;">
        From coastal condos to spacious suburban pool homes, Edgar Valle provides data-driven representation to secure your ideal San Diego property at the best possible terms.
      </p>
      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="#buyerSteps" class="btn btn-gold btn-lg">Explore the 6-Step Buyer Roadmap</a>
        <a href="/properties" class="btn btn-outline btn-lg">Browse Active Listings</a>
      </div>
    </div>
  </section>

  <!-- 6-Step Buyer Roadmap -->
  <section class="section" id="buyerSteps">
    <div class="container container-narrow">
      <div class="section-header">
        <span class="section-eyebrow">THE ROADMAP</span>
        <h2>The Edgar Valle 6-Step Purchasing Process</h2>
        <p class="lead">How we take you from browsing listings to holding the keys to your new San Diego home.</p>
      </div>

      <div class="steps-container">
        <div class="step-card card">
          <div class="step-num">01</div>
          <div class="step-content">
            <h3>Strategic Financial Discovery &amp; Pre-Approval</h3>
            <p>We connect you with premier local lenders (including direct VA and CalHFA grant specialists) to lock in your true purchasing power, understand your monthly payment ceiling, and ensure your pre-approval letter stands out against competing buyers.</p>
          </div>
        </div>

        <div class="step-card card">
          <div class="step-num">02</div>
          <div class="step-content">
            <h3>Micro-Market &amp; Neighborhood Alignment</h3>
            <p>We analyze school districts, commute times to military bases or biotech corridors, walkability scores, and HOA financial reserves to narrow down the San Diego neighborhoods that best fit your lifestyle.</p>
          </div>
        </div>

        <div class="step-card card">
          <div class="step-num">03</div>
          <div class="step-content">
            <h3>Exclusive Property Walkthroughs &amp; Off-Market Access</h3>
            <p>Tour homes with an analytical eye. Edgar inspects foundations, electrical panels, HVAC age, roof condition, and ADU potential before you fall in love with cosmetics.</p>
          </div>
        </div>

        <div class="step-card card">
          <div class="step-num">04</div>
          <div class="step-content">
            <h3>Crafting a Winning &amp; Protected Offer</h3>
            <p>We research the seller's motivation, study recent hyper-local sales, and structure competitive terms (inspection contingencies, appraisal buffers, flexible escrow dates) that win without overpaying.</p>
          </div>
        </div>

        <div class="step-card card">
          <div class="step-num">05</div>
          <div class="step-content">
            <h3>Rigorous Escrow, Inspections &amp; Negotiations</h3>
            <p>During the 21-to-30-day escrow period, we coordinate certified home inspectors, sewer scope specialists, and structural engineers. We negotiate seller repair credits or price reductions to cover discovered issues.</p>
          </div>
        </div>

        <div class="step-card card">
          <div class="step-num">06</div>
          <div class="step-content">
            <h3>Final Walkthrough &amp; Celebration of Keys</h3>
            <p>We conduct the final verification of property condition, verify all repairs have been completed to code, review the closing disclosure with you, and hand over the keys to your new home.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Consultation Form -->
  <section class="section section-secondary">
    <div class="container container-narrow">
      <LeadCaptureForm 
        leadType="first_time_buyer"
        formTitle="Schedule Your San Diego Buyer Consultation"
        buttonText="Begin Your Home Search"
      />
    </div>
  </section>
</Layout>

<style>
  .steps-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .step-card {
    display: flex;
    gap: 2rem;
    padding: 2.25rem;
    background: #ffffff;
    align-items: flex-start;
  }

  @media (max-width: 600px) {
    .step-card {
      flex-direction: column;
      gap: 1rem;
    }
  }

  .step-num {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-gold-500);
    line-height: 1;
    font-family: var(--font-serif);
    flex-shrink: 0;
  }

  .step-content h3 {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }

  .step-content p {
    font-size: 0.98rem;
    line-height: 1.7;
    margin: 0;
  }
</style>
