---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Terms of Use', url: '/terms-of-service' }
];
---

<Layout 
  title="Terms of Use"
  description="Terms of Use for accessing and browsing the Edgar Valle | Realtor website and property listings."
  canonicalUrl="/terms-of-service"
  breadcrumbs={breadcrumbItems}
>
  <Breadcrumbs items={breadcrumbItems} />
  <div class="section">
    <div class="container container-narrow">
      <div class="section-header" style="text-align: left; margin-bottom: 2.5rem;">
        <span class="section-eyebrow">LEGAL AGREEMENT</span>
        <h1>Terms of Use</h1>
        <p class="lead">Please review these terms before utilizing our San Diego real estate portal.</p>
      </div>

      <div class="card" style="padding: 2.5rem;">
        <h3>1. Agreement to Terms</h3>
        <p>By accessing or using this website, you agree to be bound by these Terms of Use and all applicable laws and regulations of the State of California and the United States.</p>

        <h3 style="margin-top: 1.5rem;">2. Permitted Use</h3>
        <p>This website is intended for consumers interested in purchasing, selling, or evaluating real estate properties in San Diego County. Unauthorized automated scraping, bulk data harvesting, or reproduction of property media and copy without written consent is strictly prohibited.</p>

        <h3 style="margin-top: 1.5rem;">3. Professional Advice Disclaimer</h3>
        <p>Content provided on this website—including mortgage estimates, tax rates, and educational guides—is for informational purposes and should not be construed as legal, tax, or financial advice. Consult licensed attorneys, CPAs, or tax advisors for specific legal and tax consequences of transactions.</p>
      </div>
    </div>
  </div>
</Layout>
