---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_SETTINGS } from '../lib/store';

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Real Estate Disclosures', url: '/disclosures' }
];
---

<Layout 
  title="California Real Estate & Brokerage Disclosures"
  description="Mandatory California DRE advertising rules, Equal Housing Opportunity, TILA-RESPA mortgage disclaimers, and Full Circle Group brokerage disclosures."
  canonicalUrl="/disclosures"
  breadcrumbs={breadcrumbItems}
>
  <Breadcrumbs items={breadcrumbItems} />
  <div class="section">
    <div class="container container-narrow">
      <div class="section-header" style="text-align: left; margin-bottom: 2.5rem;">
        <span class="section-eyebrow">REGULATORY &amp; DRE COMPLIANCE</span>
        <h1>California Real Estate Disclosures</h1>
        <p class="lead">
          Transparency, regulatory compliance, and consumer protection under the California Department of Real Estate (DRE) and federal statutes.
        </p>
      </div>

      <div class="card" style="padding: 2.5rem; margin-bottom: 2.5rem;">
        <!-- 1. Brokerage and DRE Identification -->
        <h2 style="font-size: 1.4rem; margin-bottom: 1rem;">1. Agent &amp; Responsible Broker Identification (Cal. Bus. &amp; Prof. Code §§ 10159.5, 10159.6, 10159.7)</h2>
        <p>
          In strict compliance with California Department of Real Estate advertising regulations:
        </p>
        <ul style="margin: 0 0 1.25rem 1.5rem; color: var(--text-secondary);">
          <li><strong>Agent Name:</strong> Edgar Valle</li>
          <li><strong>California DRE License Number:</strong> <strong>#02375273</strong> (First-Point-of-Contact Solicitation Disclosure)</li>
          <li><strong>Responsible Brokerage:</strong> <strong>{SITE_SETTINGS.brokerage_name}</strong></li>
          <li><strong>Market Area:</strong> San Diego County, California</li>
        </ul>
        <p>
          Pursuant to California DRE rules, the identity of the responsible broker ({SITE_SETTINGS.brokerage_name}) is displayed with equal or greater prominence across all advertising and marketing materials. Consumers may independently verify current licensing status through the California DRE Public License Information portal at <a href="https://www.dre.ca.gov" target="_blank" rel="noopener noreferrer" style="color: var(--color-gold-700); text-decoration: underline;">dre.ca.gov</a>.
        </p>

        <!-- 2. Fair Housing Act & FEHA -->
        <h2 style="font-size: 1.4rem; margin: 2rem 0 1rem 0;">2. Equal Housing Opportunity &amp; Fair Housing Act</h2>
        <div style="display: flex; gap: 1.25rem; align-items: flex-start; background: #fdfbf7; border: 1px solid var(--border-light); padding: 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1rem;">
          <svg viewBox="0 0 64 64" width="48" height="48" fill="#c5a059" style="flex-shrink: 0;" aria-hidden="true">
            <path d="M32 6 L6 28 L14 28 L14 56 L50 56 L50 28 L58 28 Z M32 18 L44 28 L20 28 Z M22 34 L42 34 L42 40 L22 40 Z M22 44 L42 44 L42 50 L22 50 Z" />
          </svg>
          <div>
            <h4 style="margin: 0 0 0.4rem 0;">Fair Housing Policy Commitment</h4>
            <p style="font-size: 0.92rem; margin: 0; color: #1e293b;">
              We are pledged to the letter and spirit of U.S. policy for the achievement of equal housing opportunity. We fully comply with the federal <strong>Fair Housing Act</strong> (Title VIII of the Civil Rights Act of 1968, as amended) and the <strong>California Fair Employment and Housing Act (FEHA)</strong>. We do not discriminate on the basis of race, color, religion, sex, handicap/disability, familial status, national origin, sexual orientation, gender identity, marital status, ancestry, or source of income.
            </p>
          </div>
        </div>

        <!-- 3. Mortgage Advertising & TILA-RESPA -->
        <h2 style="font-size: 1.4rem; margin: 2rem 0 1rem 0;">3. Mortgage-Related Advertising Disclosures (TILA-RESPA / Regulation Z)</h2>
        <p>
          <strong>Edgar Valle is a licensed Real Estate Agent, NOT a licensed mortgage lender or Mortgage Loan Originator (MLO).</strong>
        </p>
        <p>
          Any mortgage loan calculators, estimated monthly payments, down payment percentages, interest rate illustrations, VA loan funding fee charts, or California Housing Finance Agency (CalHFA) program summaries provided on this site are for <strong>educational and informational purposes only</strong>. They do not constitute an offer of credit, a loan pre-approval, an interest rate lock, or a commitment to lend under the Truth in Lending Act (TILA), Real Estate Settlement Procedures Act (RESPA), or Federal Reserve Regulation Z.
        </p>
        <p>
          All financing terms, interest rates, and loan qualifications are subject to independent credit underwriting and approval by an NMLS-licensed mortgage lender of your choice.
        </p>

        <!-- 4. Virtually Staged & Altered Images -->
        <h2 style="font-size: 1.4rem; margin: 2rem 0 1rem 0;">4. Digitally Altered &amp; Virtually Staged Media Disclosure</h2>
        <p>
          Certain property photographs and virtual tours displayed on this website may include <strong>digital staging, virtual renovation, architectural rendering, or drone-captured photography</strong>.
        </p>
        <p>
          Virtually staged images represent potential furniture arrangements and aesthetic concepts. They do not depict the actual furnishings or fixtures included in the purchase price unless explicitly agreed upon in a written Purchase and Sale Agreement. Prospective purchasers are strongly advised to physically tour the property and conduct thorough professional home inspections.
        </p>

        <!-- 5. Multiple Listing Service (MLS) Content -->
        <h2 style="font-size: 1.4rem; margin: 2rem 0 1rem 0;">5. Property Information &amp; MLS Syndication Accuracy</h2>
        <p>
          Property information is derived from sources deemed reliable—including local Multiple Listing Services (San Diego MLS / CRMLS), county tax assessor records, architectural plans, and sellers—but has not been independently verified and is not guaranteed.
        </p>
        <p>
          Square footage, lot boundaries, bedroom/bathroom counts, zoning entitlements (including California SB9 ADU potential), HOA covenants, and tax estimates must be confirmed through your independent appraisal, boundary survey, and licensed professional inspections.
        </p>

        <!-- 6. Legal & Tax Disclaimer -->
        <h2 style="font-size: 1.4rem; margin: 2rem 0 1rem 0;">6. No Legal, Architectural, or Tax Advice Disclaimer</h2>
        <p>
          <em>Legal Notice:</em> The information presented on this website does not constitute legal, tax, CPA, structural engineering, or architectural advice. Real estate laws and tax rules (including California Prop 19 and 1031 exchanges) are complex and subject to change. Parties to any transaction must consult their own qualified legal counsel, certified public accountants, and licensed general contractors.
        </p>

        <!-- 7. Active Agency Solicitation Notice -->
        <h2 style="font-size: 1.4rem; margin: 2rem 0 1rem 0;">7. Non-Solicitation of Existing Brokerage Agreements</h2>
        <p>
          If your property is currently listed under an exclusive right-to-sell agreement with another licensed real estate brokerage, please disregard any marketing messages on this site. This website is not intended as a solicitation of clients currently represented by other brokerages.
        </p>
      </div>

      <div style="text-align: center;">
        <a href="/contact" class="btn btn-gold btn-lg">Connect with Edgar Valle | Realtor</a>
      </div>
    </div>
  </div>
</Layout>
