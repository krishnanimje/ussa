---
import Layout from '../../layouts/Layout.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import { getProperties, getNeighborhoods } from '../../lib/store';

const allProperties = await getProperties();
const neighborhoods = await getNeighborhoods();

// Parse initial URL search params if present
const neighborhoodParam = Astro.url.searchParams.get('neighborhood') || 'all';
const typeParam = Astro.url.searchParams.get('type') || 'all';
const maxPriceParam = Astro.url.searchParams.get('maxPrice') || '';
const vaParam = Astro.url.searchParams.get('va') === 'true';
const fixerParam = Astro.url.searchParams.get('fixer') === 'true';
const poolParam = Astro.url.searchParams.get('pool') === 'true';
---

<Layout 
  title="San Diego Homes for Sale & Real Estate Listings"
  description="Browse verified San Diego real estate listings curated by Edgar Valle | Realtor. Filter by neighborhood, VA loan eligibility, swimming pools, garages, and fix-and-flip opportunities."
>
  <!-- Page Header -->
  <section class="section-sm section-secondary">
    <div class="container">
      <div class="properties-hero-header">
        <div>
          <span class="section-eyebrow">SAN DIEGO PROPERTY SEARCH</span>
          <h1 style="margin-bottom: 0.5rem;">San Diego Homes for Sale</h1>
          <p class="lead" style="margin: 0;">Explore active residences, luxury coastal condos, suburban pool estates, and value-add investments.</p>
        </div>
        <div class="inventory-stat-box">
          <span class="inventory-num">{allProperties.length}</span>
          <span class="inventory-label">Active Listings</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter & Property Grid Container -->
  <section class="section" style="padding-top: 2rem;">
    <div class="container">
      <!-- Filter Bar Card -->
      <div class="card filter-bar-card" id="filterCard">
        <div class="filter-top-row">
          <h3 class="filter-heading">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
            Filter San Diego Properties
          </h3>
          <button type="button" id="resetFiltersBtn" class="reset-btn">Reset All Filters</button>
        </div>

        <div class="filter-controls-grid">
          <!-- Neighborhood -->
          <div class="filter-field">
            <label for="filterNeighborhood" class="form-label">Neighborhood</label>
            <select id="filterNeighborhood" class="form-select">
              <option value="all">All San Diego Areas</option>
              {neighborhoods.map(n => (
                <option value={n.name} selected={neighborhoodParam.toLowerCase() === n.name.toLowerCase()}>{n.name}</option>
              ))}
              <option value="Clairemont" selected={neighborhoodParam.toLowerCase() === 'clairemont'}>Clairemont</option>
              <option value="San Carlos" selected={neighborhoodParam.toLowerCase() === 'san carlos'}>San Carlos</option>
              <option value="Golden Hill" selected={neighborhoodParam.toLowerCase() === 'golden hill'}>Golden Hill</option>
            </select>
          </div>

          <!-- Property Type -->
          <div class="filter-field">
            <label for="filterType" class="form-label">Property Type</label>
            <select id="filterType" class="form-select">
              <option value="all">All Types</option>
              <option value="Single Family" selected={typeParam === 'Single Family'}>Single Family</option>
              <option value="Condo" selected={typeParam === 'Condo'}>Condo</option>
              <option value="Townhome" selected={typeParam === 'Townhome'}>Townhome</option>
              <option value="Multi-Family" selected={typeParam === 'Multi-Family'}>Multi-Family</option>
              <option value="Fixer-Upper" selected={typeParam === 'Fixer-Upper' || fixerParam}>Fixer-Upper / ARV</option>
            </select>
          </div>

          <!-- Min Bedrooms -->
          <div class="filter-field">
            <label for="filterBeds" class="form-label">Min Bedrooms</label>
            <select id="filterBeds" class="form-select">
              <option value="0">Any Beds</option>
              <option value="2">2+ Beds</option>
              <option value="3">3+ Beds</option>
              <option value="4">4+ Beds</option>
            </select>
          </div>

          <!-- Max Price -->
          <div class="filter-field">
            <label for="filterMaxPrice" class="form-label">Max Price</label>
            <select id="filterMaxPrice" class="form-select">
              <option value="9999999">No Max</option>
              <option value="800000" selected={maxPriceParam === '800000'}>Under $800,000</option>
              <option value="1000000" selected={maxPriceParam === '1000000'}>Under $1,000,000</option>
              <option value="1250000" selected={maxPriceParam === '1250000'}>Under $1,250,000</option>
              <option value="1500000" selected={maxPriceParam === '1500000'}>Under $1,500,000</option>
              <option value="2000000" selected={maxPriceParam === '2000000'}>Under $2,000,000</option>
            </select>
          </div>
        </div>

        <!-- Specialty Toggles Row -->
        <div class="specialty-checkboxes">
          <label class="check-label">
            <input type="checkbox" id="checkVa" checked={vaParam} />
            <span>🎖️ VA Loan Ready (0% Down)</span>
          </label>
          <label class="check-label">
            <input type="checkbox" id="checkPool" checked={poolParam} />
            <span>🏊 Private Pool</span>
          </label>
          <label class="check-label">
            <input type="checkbox" id="checkGarage" />
            <span>🚗 2+ Car Garage</span>
          </label>
          <label class="check-label">
            <input type="checkbox" id="checkFixer" checked={fixerParam} />
            <span>🔨 Fix &amp; Flip / High ARV</span>
          </label>
          <label class="check-label">
            <input type="checkbox" id="checkOpenHouse" />
            <span>🚪 Open Houses This Weekend</span>
          </label>
        </div>
      </div>

      <!-- Results Count & Sort Header -->
      <div class="results-bar">
        <div class="results-count" id="resultsCount">
          Showing <strong>{allProperties.length}</strong> San Diego Properties
        </div>
        <div class="sort-wrap">
          <label for="sortOrder" style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);">Sort By:</label>
          <select id="sortOrder" class="form-select" style="padding: 0.45rem 0.85rem; font-size: 0.85rem; width: auto;">
            <option value="featured">Featured First</option>
            <option value="price-asc">Price: Low to High</option>
            <option value="price-desc">Price: High to Low</option>
            <option value="sqft-desc">Square Footage</option>
          </select>
        </div>
      </div>

      <!-- Properties Grid -->
      <div class="grid-3 properties-grid" id="propertiesContainer">
        {allProperties.map(property => (
          <div 
            class="property-grid-item"
            data-id={property.id}
            data-price={property.price}
            data-neighborhood={property.neighborhood}
            data-type={property.property_type}
            data-beds={property.bedrooms}
            data-baths={property.bathrooms}
            data-sqft={property.square_feet}
            data-pool={property.has_pool ? 'true' : 'false'}
            data-garage={property.garage_spaces}
            data-va={property.is_va_eligible ? 'true' : 'false'}
            data-fixer={property.is_fixer_upper ? 'true' : 'false'}
            data-openhouse={property.status === 'open_house' ? 'true' : 'false'}
            data-featured={property.is_featured ? 'true' : 'false'}
          >
            <PropertyCard property={property} />
          </div>
        ))}
      </div>

      <!-- Empty State Container (Initially Hidden) -->
      <div id="noResults" class="no-results-box card" style="display: none;">
        <h3>No Properties Match Your Filter Criteria</h3>
        <p>Try broadening your price range or unchecking specialty filters to view more San Diego properties.</p>
        <button type="button" class="btn btn-gold" id="clearAllBtn">Reset All Filters</button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .properties-hero-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .inventory-stat-box {
    background: #ffffff;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 0.85rem 1.75rem;
    text-align: center;
    box-shadow: var(--shadow-sm);
  }

  .inventory-num {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-gold-700);
    line-height: 1;
  }

  .inventory-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .filter-bar-card {
    padding: 1.75rem;
    background: #ffffff;
    margin-bottom: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .filter-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .filter-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.15rem;
    margin: 0;
  }

  .reset-btn {
    background: none;
    border: none;
    color: var(--color-gold-700);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
  }

  .filter-controls-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 960px) {
    .filter-controls-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .filter-controls-grid {
      grid-template-columns: 1fr;
    }
  }

  .specialty-checkboxes {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .check-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .check-label input {
    accent-color: var(--color-gold-500);
    width: 16px;
    height: 16px;
  }

  .results-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.75rem;
  }

  .results-count {
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .sort-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .no-results-box {
    text-align: center;
    padding: 4rem 2rem;
    max-width: 600px;
    margin: 3rem auto;
  }
</style>

<script>
  function setupLiveFiltering() {
    const container = document.getElementById('propertiesContainer');
    if (!container) return;

    const hoodSelect = document.getElementById('filterNeighborhood') as HTMLSelectElement;
    const typeSelect = document.getElementById('filterType') as HTMLSelectElement;
    const bedsSelect = document.getElementById('filterBeds') as HTMLSelectElement;
    const priceSelect = document.getElementById('filterMaxPrice') as HTMLSelectElement;
    const vaCheck = document.getElementById('checkVa') as HTMLInputElement;
    const poolCheck = document.getElementById('checkPool') as HTMLInputElement;
    const garageCheck = document.getElementById('checkGarage') as HTMLInputElement;
    const fixerCheck = document.getElementById('checkFixer') as HTMLInputElement;
    const openCheck = document.getElementById('checkOpenHouse') as HTMLInputElement;
    const sortSelect = document.getElementById('sortOrder') as HTMLSelectElement;

    const countDisplay = document.getElementById('resultsCount')!;
    const noResults = document.getElementById('noResults')!;
    const resetBtn = document.getElementById('resetFiltersBtn');
    const clearAllBtn = document.getElementById('clearAllBtn');

    const items = Array.from(container.querySelectorAll('.property-grid-item')) as HTMLElement[];

    function applyFilters() {
      const selectedHood = hoodSelect.value.toLowerCase();
      const selectedType = typeSelect.value;
      const minBeds = parseInt(bedsSelect.value, 10) || 0;
      const maxPrice = parseFloat(priceSelect.value) || 9999999;
      const requireVa = vaCheck.checked;
      const requirePool = poolCheck.checked;
      const requireGarage = garageCheck.checked;
      const requireFixer = fixerCheck.checked;
      const requireOpen = openCheck.checked;

      let visibleCount = 0;

      items.forEach(item => {
        const hood = (item.dataset.neighborhood || '').toLowerCase();
        const type = item.dataset.type || '';
        const beds = parseInt(item.dataset.beds || '0', 10);
        const price = parseFloat(item.dataset.price || '0');
        const garage = parseInt(item.dataset.garage || '0', 10);
        const hasPool = item.dataset.pool === 'true';
        const isVa = item.dataset.va === 'true';
        const isFixer = item.dataset.fixer === 'true';
        const isOpen = item.dataset.openhouse === 'true';

        let show = true;

        if (selectedHood !== 'all' && hood !== selectedHood) show = false;
        if (selectedType !== 'all' && type !== selectedType) show = false;
        if (beds < minBeds) show = false;
        if (price > maxPrice) show = false;
        if (requireVa && !isVa) show = false;
        if (requirePool && !hasPool) show = false;
        if (requireGarage && garage < 2) show = false;
        if (requireFixer && !isFixer) show = false;
        if (requireOpen && !isOpen) show = false;

        if (show) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      countDisplay.innerHTML = `Showing <strong>${visibleCount}</strong> of ${items.length} San Diego Properties`;

      if (visibleCount === 0) {
        noResults.style.display = 'block';
      } else {
        noResults.style.display = 'none';
      }
    }

    function sortProperties() {
      const sort = sortSelect.value;
      const sorted = [...items].sort((a, b) => {
        const priceA = parseFloat(a.dataset.price || '0');
        const priceB = parseFloat(b.dataset.price || '0');
        const sqftA = parseFloat(a.dataset.sqft || '0');
        const sqftB = parseFloat(b.dataset.sqft || '0');
        const featA = a.dataset.featured === 'true' ? 1 : 0;
        const featB = b.dataset.featured === 'true' ? 1 : 0;

        if (sort === 'price-asc') return priceA - priceB;
        if (sort === 'price-desc') return priceB - priceA;
        if (sort === 'sqft-desc') return sqftB - sqftA;
        return featB - featA; // featured first
      });

      if (container) {
        sorted.forEach(item => container.appendChild(item));
      }
    }

    function resetFilters() {
      hoodSelect.value = 'all';
      typeSelect.value = 'all';
      bedsSelect.value = '0';
      priceSelect.value = '9999999';
      vaCheck.checked = false;
      poolCheck.checked = false;
      garageCheck.checked = false;
      fixerCheck.checked = false;
      openCheck.checked = false;
      sortSelect.value = 'featured';
      applyFilters();
      sortProperties();
    }

    [hoodSelect, typeSelect, bedsSelect, priceSelect, vaCheck, poolCheck, garageCheck, fixerCheck, openCheck].forEach(el => {
      el.addEventListener('change', applyFilters);
    });

    sortSelect.addEventListener('change', sortProperties);
    if (resetBtn) resetBtn.addEventListener('click', resetFilters);
    if (clearAllBtn) clearAllBtn.addEventListener('click', resetFilters);

    // Initial pass in case URL params are present
    applyFilters();
  }

  document.addEventListener('astro:page-load', setupLiveFiltering);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupLiveFiltering();
  }
</script>
