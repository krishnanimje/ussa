---
export const prerender = false;
import { verifyAdminCredentials, createAdminSessionCookie } from '../../lib/auth';

let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const keyOrPassword = (data.get('secretKey') as string) || '';
    const email = (data.get('email') as string) || undefined;

    if (!keyOrPassword) {
      errorMessage = 'Please enter your administrator passphrase or password.';
    } else {
      const authResult = await verifyAdminCredentials(keyOrPassword, email);

      if (authResult.success) {
        // Set secure HTTP-only session cookie
        const isProd = import.meta.env.PROD || process.env.NODE_ENV === 'production';
        Astro.response.headers.set('Set-Cookie', createAdminSessionCookie(isProd));
        return Astro.redirect('/admin');
      } else {
        errorMessage = authResult.error || 'Invalid credentials. Access is restricted to authorized personnel.';
      }
    }
  } catch (err) {
    errorMessage = 'An error occurred during authentication. Please retry.';
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Agent Login | Edgar Valle Real Estate</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #090e14;
        color: #f1f5f9;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
      }
      .login-box {
        background: #101923;
        border: 1px solid #1e2c3c;
        border-radius: 12px;
        padding: 2.5rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
      }
      .logo-img {
        height: 52px;
        width: auto;
        display: block;
        margin: 0 auto 1.5rem auto;
      }
      h2 {
        text-align: center;
        margin: 0 0 0.5rem 0;
        font-size: 1.4rem;
        color: #ffffff;
      }
      p {
        text-align: center;
        color: #8b9bb0;
        font-size: 0.88rem;
        margin: 0 0 1.75rem 0;
      }
      .error-alert {
        background: #450a0a;
        border: 1px solid #7f1d1d;
        color: #fecaca;
        padding: 0.75rem 1rem;
        border-radius: 6px;
        font-size: 0.85rem;
        margin-bottom: 1.25rem;
      }
      label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 0.4rem;
        color: #cbd5e1;
      }
      input {
        width: 100%;
        padding: 0.85rem 1rem;
        box-sizing: border-box;
        background: #090e14;
        border: 1px solid #1e2c3c;
        border-radius: 6px;
        color: #ffffff;
        font-size: 0.95rem;
        margin-bottom: 1.25rem;
      }
      input:focus {
        outline: none;
        border-color: #c5a059;
      }
      button {
        width: 100%;
        padding: 0.85rem;
        background: linear-gradient(135deg, #dfc26e 0%, #c5a059 100%);
        color: #090e14;
        font-weight: 700;
        font-size: 0.95rem;
        border: none;
        border-radius: 6px;
        cursor: pointer;
      }
      button:hover {
        filter: brightness(1.08);
      }
      .hint {
        margin-top: 1.25rem;
        font-size: 0.78rem;
        color: #64748b;
        text-align: center;
      }
      .auth-options {
        margin-top: 1rem;
        text-align: center;
        font-size: 0.8rem;
      }
      .auth-toggle {
        background: none;
        border: none;
        color: #c5a059;
        cursor: pointer;
        font-size: 0.8rem;
        padding: 0;
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="login-box">
      <img src="/images/branding/logo-white.svg" alt="Edgar Valle" class="logo-img" />
      <h2>Agent Portal Login</h2>
      <p>Authorized access for Edgar Valle &amp; Brokerage Staff</p>

      {errorMessage && <div class="error-alert" role="alert">{errorMessage}</div>}

      <form method="POST" id="adminLoginForm">
        <div id="emailField" style="display: none;">
          <label for="adminEmail">Staff Email</label>
          <input 
            type="email" 
            id="adminEmail" 
            name="email" 
            placeholder="edgar@yourrealtoredgar.com" 
            autocomplete="username"
          />
        </div>

        <label for="secretKey" id="secretKeyLabel">Administrator Passphrase</label>
        <input 
          type="password" 
          id="secretKey" 
          name="secretKey" 
          placeholder="Enter authorized administrator key" 
          required 
          autocomplete="current-password"
        />
        <button type="submit" id="authSubmitBtn">Authenticate Session</button>
      </form>

      <div class="auth-options">
        <button type="button" id="toggleAuthMode" class="auth-toggle">Switch to Supabase Email / Password</button>
      </div>

      <div class="hint">
        Protected by California DRE security compliance standards. Public registration is disabled.
      </div>
    </div>

    <script is:inline>
      var toggleBtn = document.getElementById('toggleAuthMode');
      var emailField = document.getElementById('emailField');
      var secretLabel = document.getElementById('secretKeyLabel');
      var secretInput = document.getElementById('secretKey');
      var emailInput = document.getElementById('adminEmail');
      var isSupabaseMode = false;

      if (toggleBtn) {
        toggleBtn.addEventListener('click', function() {
          isSupabaseMode = !isSupabaseMode;
          if (isSupabaseMode) {
            emailField.style.display = 'block';
            emailInput.setAttribute('required', 'true');
            secretLabel.textContent = 'Account Password';
            secretInput.placeholder = 'Enter Supabase password';
            toggleBtn.textContent = 'Switch to Admin Secret Passphrase';
          } else {
            emailField.style.display = 'none';
            emailInput.removeAttribute('required');
            secretLabel.textContent = 'Administrator Passphrase';
            secretInput.placeholder = 'Enter authorized administrator key';
            toggleBtn.textContent = 'Switch to Supabase Email / Password';
          }
        });
      }
    </script>
  </body>
</html>
