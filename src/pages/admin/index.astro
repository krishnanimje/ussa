---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getPropertyStats, getAllLeads, getPropertiesPaginated, SITE_SETTINGS } from '../../lib/store';
import { formatCurrency } from '../../lib/mortgage';
import { checkAdminAuth } from '../../lib/auth';
import { logger } from '../../lib/logger';

export const prerender = false;

if (!checkAdminAuth(Astro.request)) {
  return Astro.redirect('/admin/login');
}

let stats = { total: 0, published: 0, draft: 0, pending: 0, archived: 0, totalVolume: 0, totalInquiries: 0 };
let leads: any[] = [];
let recentProperties: any[] = [];

try {
  const [statsData, leadsData, propsData] = await Promise.all([
    getPropertyStats(),
    getAllLeads(),
    getPropertiesPaginated({ page: 1, pageSize: 5, includeUnpublished: true, includeDeleted: false })
  ]);
  stats = statsData;
  leads = leadsData;
  recentProperties = propsData.properties;
} catch (err: any) {
  logger.error('Failed to load dashboard data', { error: err.message });
}

const newLeadsCount = leads.filter(l => l.status === 'new').length;
---

<AdminLayout title="Dashboard" activeNav="dashboard">
  <!-- Header -->
  <div class="admin-header" style="flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.85rem; margin: 0 0 0.25rem 0; color: #ffffff;">Admin Dashboard</h1>
      <p style="color: var(--admin-text-muted); margin: 0; font-size: 0.9rem;">
        Welcome back, Edgar Valle! Here is a simple overview of your real estate website.
      </p>
    </div>
    <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
      <a href="/" target="_blank" class="btn btn-outline-white btn-sm">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        View Public Site
      </a>
      <a href="/admin/properties/new" class="btn btn-gold btn-sm" style="font-weight: 700;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
        + Add New Property
      </a>
    </div>
  </div>

  <!-- 3 Simple Stat Cards -->
  <div class="admin-kpi-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 2rem;">
    <div class="kpi-card" style="padding: 1.25rem; border-top: 3px solid var(--color-gold-500);">
      <div class="kpi-title">Total Properties</div>
      <div class="kpi-value">{stats.total}</div>
      <div style="font-size: 0.82rem; color: #10b981; margin-top: 4px;">
        ● {stats.published} Live on site &bull; <span style="color: #f59e0b;">{stats.draft} Drafts</span>
      </div>
    </div>

    <div class="kpi-card" style="padding: 1.25rem; border-top: 3px solid #38bdf8;">
      <div class="kpi-title">Client Inquiries</div>
      <div class="kpi-value" style="color: #38bdf8;">{leads.length}</div>
      <div style="font-size: 0.82rem; color: #f59e0b; margin-top: 4px;">
        {newLeadsCount > 0 ? `🔥 ${newLeadsCount} New Inquiries to follow up` : 'All caught up'}
      </div>
    </div>

    <div class="kpi-card" style="padding: 1.25rem; border-top: 3px solid #10b981;">
      <div class="kpi-title">Total Portfolio Value</div>
      <div class="kpi-value" style="color: var(--color-gold-400); font-size: 1.6rem;">
        {formatCurrency(stats.totalVolume || 0)}
      </div>
      <div style="font-size: 0.82rem; color: var(--admin-text-muted); margin-top: 4px;">
        Active catalog value
      </div>
    </div>
  </div>

  <!-- Quick Action Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-bottom: 2.5rem;">
    <a href="/admin/properties/new" class="card" style="padding: 1.5rem; text-decoration: none; border-left: 4px solid var(--color-gold-500); transition: transform 0.15s ease;">
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <div>
          <h3 style="font-size: 1.1rem; color: #ffffff; margin: 0 0 0.35rem 0;">+ Add New Property</h3>
          <p style="color: var(--admin-text-muted); font-size: 0.85rem; margin: 0;">Add a new listing with photos, price &amp; specs.</p>
        </div>
        <span style="color: var(--color-gold-400); font-size: 1.5rem; font-weight: bold;">&rarr;</span>
      </div>
    </a>

    <a href="/admin/properties" class="card" style="padding: 1.5rem; text-decoration: none; border-left: 4px solid #10b981; transition: transform 0.15s ease;">
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <div>
          <h3 style="font-size: 1.1rem; color: #ffffff; margin: 0 0 0.35rem 0;">Manage Properties</h3>
          <p style="color: var(--admin-text-muted); font-size: 0.85rem; margin: 0;">Edit existing properties, change prices, or toggle visibility.</p>
        </div>
        <span style="color: #10b981; font-size: 1.5rem; font-weight: bold;">&rarr;</span>
      </div>
    </a>

    <a href="/admin/leads" class="card" style="padding: 1.5rem; text-decoration: none; border-left: 4px solid #38bdf8; transition: transform 0.15s ease;">
      <div style="display: flex; align-items: center; justify-content: space-between;">
        <div>
          <h3 style="font-size: 1.1rem; color: #ffffff; margin: 0 0 0.35rem 0;">View Inquiries ({leads.length})</h3>
          <p style="color: var(--admin-text-muted); font-size: 0.85rem; margin: 0;">Contact buyers, sellers, and view messages.</p>
        </div>
        <span style="color: #38bdf8; font-size: 1.5rem; font-weight: bold;">&rarr;</span>
      </div>
    </a>
  </div>

  <!-- Recent Properties -->
  <div style="margin-bottom: 2.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
      <h2 style="font-size: 1.25rem; color: #ffffff; margin: 0;">Recent Properties</h2>
      <a href="/admin/properties" style="color: var(--color-gold-400); font-size: 0.88rem; text-decoration: none; font-weight: 600;">
        View All Properties &rarr;
      </a>
    </div>

    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th style="width: 70px;">Photo</th>
            <th>Property Title</th>
            <th>Price</th>
            <th>Type</th>
            <th>Status</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          {recentProperties.length === 0 ? (
            <tr>
              <td colspan="6" style="text-align: center; padding: 2.5rem; color: var(--admin-text-muted);">
                No properties yet. <a href="/admin/properties/new" style="color: var(--color-gold-400);">Click here to add one</a>.
              </td>
            </tr>
          ) : (
            recentProperties.map(p => (
              <tr>
                <td style="width: 70px;">
                  <img 
                    src={p.primary_image || '/images/properties/north-park-spanish.svg'} 
                    alt={p.title} 
                    width="60" 
                    height="40" 
                    style="border-radius: 4px; object-fit: cover; display: block; border: 1px solid var(--admin-border);" 
                  />
                </td>
                <td>
                  <strong style="color: #ffffff; font-size: 0.92rem;">{p.title}</strong>
                  <div style="font-size: 0.78rem; color: var(--admin-text-muted);">{p.neighborhood}, {p.address_city}</div>
                </td>
                <td>
                  <strong style="color: var(--color-gold-400);">{formatCurrency(p.price)}</strong>
                </td>
                <td style="font-size: 0.85rem; color: #cbd5e1;">{p.property_type}</td>
                <td>
                  <span class:list={['badge', p.publication_status === 'published' ? 'badge-emerald' : 'badge-gold']}>
                    {p.publication_status === 'published' ? 'Live' : 'Draft'}
                  </span>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                  <a href={`/admin/properties/edit?id=${p.id}`} class="btn btn-outline-white btn-sm" style="padding: 0.35rem 0.65rem;">
                    Edit
                  </a>
                  <a href={`/properties/${p.slug}`} target="_blank" class="btn-icon" style="margin-left: 4px;" title="View on website">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  </a>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Recent Inquiries -->
  <div>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
      <h2 style="font-size: 1.25rem; color: #ffffff; margin: 0;">Recent Client Inquiries</h2>
      <a href="/admin/leads" style="color: var(--color-gold-400); font-size: 0.88rem; text-decoration: none; font-weight: 600;">
        View All Inquiries &rarr;
      </a>
    </div>

    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Client Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Inquiry Type</th>
            <th>Date</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {leads.length === 0 ? (
            <tr>
              <td colspan="6" style="text-align: center; padding: 2.5rem; color: var(--admin-text-muted);">
                No client inquiries received yet.
              </td>
            </tr>
          ) : (
            leads.slice(0, 5).map(lead => (
              <tr>
                <td>
                  <strong style="color: #ffffff;">{lead.full_name}</strong>
                  {lead.property_address && (
                    <div style="font-size: 0.75rem; color: var(--admin-text-muted);">Ref: {lead.property_address}</div>
                  )}
                </td>
                <td>
                  <a href={`tel:${lead.phone}`} style="color: #38bdf8; text-decoration: none; font-size: 0.88rem;">
                    {lead.phone}
                  </a>
                </td>
                <td>
                  <a href={`mailto:${lead.email}`} style="color: #cbd5e1; text-decoration: none; font-size: 0.85rem;">
                    {lead.email}
                  </a>
                </td>
                <td>
                  <span class="badge badge-dark" style="text-transform: capitalize;">
                    {(lead.lead_type || 'General').replace('_', ' ')}
                  </span>
                </td>
                <td style="font-size: 0.82rem; color: var(--admin-text-muted);">
                  {new Date(lead.created_at).toLocaleDateString()}
                </td>
                <td>
                  <span class:list={[
                    'badge',
                    lead.status === 'new' ? 'badge-gold' :
                    lead.status === 'contacted' ? 'badge-blue' : 'badge-emerald'
                  ]}>
                    {lead.status}
                  </span>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
