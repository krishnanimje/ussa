---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getPropertyStats, getAllLeads, getAuditLogs, SITE_SETTINGS } from '../../lib/store';
import { formatCurrency } from '../../lib/mortgage';
import { checkAdminAuth } from '../../lib/auth';

export const prerender = false;

if (!checkAdminAuth(Astro.request)) {
  return Astro.redirect('/admin/login');
}

const stats = await getPropertyStats();
const leads = await getAllLeads();
const auditLogs = await getAuditLogs(8);

const newLeadsCount = leads.filter(l => l.status === 'new').length;
---

<AdminLayout title="Dashboard" activeNav="dashboard">
  <!-- Header -->
  <div class="admin-header">
    <div>
      <h1 style="font-size: 1.85rem; margin: 0 0 0.25rem 0; color: #ffffff;">Executive Dashboard</h1>
      <p style="color: var(--admin-text-muted); margin: 0; font-size: 0.9rem;">
        Edgar Valle Real Estate • {SITE_SETTINGS.brokerage_name} • DRE #{SITE_SETTINGS.dre_license}
      </p>
    </div>
    <div style="display: flex; gap: 0.75rem; align-items: center;">
      <a href="/admin/properties/new" class="btn btn-gold btn-sm" style="display: inline-flex; align-items: center; gap: 0.35rem;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Property
      </a>
      <a href="/admin/properties" class="btn btn-outline-white btn-sm">Inventory Manager</a>
    </div>
  </div>

  <!-- Property Inventory Summary Ribbon -->
  <div class="admin-kpi-grid" style="grid-template-columns: repeat(6, 1fr); margin-bottom: 2rem;">
    <div class="kpi-card" style="padding: 1.15rem;">
      <div class="kpi-title">Total Catalog</div>
      <div class="kpi-value">{stats.total}</div>
      <span style="font-size: 0.75rem; color: var(--admin-text-muted);">Properties</span>
    </div>

    <div class="kpi-card" style="padding: 1.15rem; border-top: 3px solid #10b981;">
      <div class="kpi-title">Published</div>
      <div class="kpi-value" style="color: #10b981;">{stats.published}</div>
      <span style="font-size: 0.75rem; color: #10b981;">Public Live</span>
    </div>

    <div class="kpi-card" style="padding: 1.15rem; border-top: 3px solid #f59e0b;">
      <div class="kpi-title">Drafts</div>
      <div class="kpi-value" style="color: #f59e0b;">{stats.draft}</div>
      <span style="font-size: 0.75rem; color: #f59e0b;">In Preparation</span>
    </div>

    <div class="kpi-card" style="padding: 1.15rem; border-top: 3px solid #ef4444;">
      <div class="kpi-title">Pending Escrow</div>
      <div class="kpi-value" style="color: #ef4444;">{stats.pending}</div>
      <span style="font-size: 0.75rem; color: #ef4444;">Under Contract</span>
    </div>

    <div class="kpi-card" style="padding: 1.15rem; border-top: 3px solid #94a3b8;">
      <div class="kpi-title">Archived</div>
      <div class="kpi-value" style="color: #94a3b8;">{stats.archived}</div>
      <span style="font-size: 0.75rem; color: #94a3b8;">Historical Reporting</span>
    </div>

    <div class="kpi-card" style="padding: 1.15rem; border-top: 3px solid var(--color-gold-400);">
      <div class="kpi-title">Client Leads</div>
      <div class="kpi-value" style="color: var(--color-gold-400);">{leads.length}</div>
      <span style="font-size: 0.75rem; color: #f59e0b;">{newLeadsCount} Need Follow-up</span>
    </div>
  </div>

  <div class="grid-2" style="gap: 2rem; margin-bottom: 2.5rem;">
    <!-- Recent Audit Activity Log Stream -->
    <div>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h2 style="font-size: 1.25rem; color: #ffffff; margin: 0; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold-400)" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          Security &amp; Audit Activity Stream
        </h2>
        <span style="font-size: 0.75rem; color: var(--admin-text-muted);">Real-time log</span>
      </div>

      <div class="admin-form-section" style="padding: 1.25rem; margin: 0;">
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          {auditLogs.map(log => (
            <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 0.6rem 0; border-bottom: 1px solid rgba(255,255,255,0.06);">
              <div>
                <span class:list={[
                  'badge',
                  log.action === 'create_property' ? 'badge-emerald' :
                  log.action === 'publish_property' ? 'badge-blue' :
                  log.action === 'update_price' ? 'badge-gold' :
                  log.action === 'delete_property' ? 'badge-ruby' : 'badge-dark'
                ]} style="font-size: 0.65rem; padding: 1px 6px; margin-right: 6px;">
                  {log.action.replace('_', ' ').toUpperCase()}
                </span>
                <span style="font-size: 0.85rem; color: #ffffff;">
                  {(log.details as any)?.title || log.entity_type}
                </span>
                {(log.details as any)?.new_price && (
                  <div style="font-size: 0.75rem; color: var(--color-gold-400); margin-top: 2px;">
                    Price updated to {formatCurrency((log.details as any).new_price)}
                  </div>
                )}
              </div>
              <div style="font-size: 0.72rem; color: var(--admin-text-muted); text-align: right; white-space: nowrap;">
                {new Date(log.created_at).toLocaleDateString()}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Quick Actions & Pipeline -->
    <div>
      <h2 style="font-size: 1.25rem; color: #ffffff; margin: 0 0 1rem 0;">Property Pipeline Shortcuts</h2>
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <a href="/admin/properties/new" class="card" style="padding: 1.25rem; text-decoration: none; border-left: 4px solid var(--color-gold-500); background: var(--admin-surface); display: flex; justify-content: space-between; align-items: center;">
          <div>
            <strong style="color: #ffffff; font-size: 1rem; display: block;">+ Create New Listing Draft</strong>
            <span style="color: var(--admin-text-muted); font-size: 0.82rem;">Draft and stage residential or investment property before public launch.</span>
          </div>
          <span style="color: var(--color-gold-400); font-weight: 700;">&rarr;</span>
        </a>

        <a href="/admin/properties?publicationStatus=draft" class="card" style="padding: 1.25rem; text-decoration: none; border-left: 4px solid #f59e0b; background: var(--admin-surface); display: flex; justify-content: space-between; align-items: center;">
          <div>
            <strong style="color: #ffffff; font-size: 1rem; display: block;">Review Unpublished Drafts ({stats.draft})</strong>
            <span style="color: var(--admin-text-muted); font-size: 0.82rem;">Listings ready for final review, photography upload, and publishing.</span>
          </div>
          <span style="color: #f59e0b; font-weight: 700;">&rarr;</span>
        </a>

        <a href="/admin/leads?status=new" class="card" style="padding: 1.25rem; text-decoration: none; border-left: 4px solid #10b981; background: var(--admin-surface); display: flex; justify-content: space-between; align-items: center;">
          <div>
            <strong style="color: #ffffff; font-size: 1rem; display: block;">Pending Inquiries ({newLeadsCount})</strong>
            <span style="color: var(--admin-text-muted); font-size: 0.82rem;">Buyers and sellers waiting for phone/text follow-up from Edgar.</span>
          </div>
          <span style="color: #10b981; font-weight: 700;">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Recent Leads Table -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
    <h2 style="font-size: 1.35rem; color: #ffffff; margin: 0;">Recent Client Inquiries</h2>
    <a href="/admin/leads" style="color: var(--color-gold-400); font-size: 0.88rem; text-decoration: underline;">View All Leads &rarr;</a>
  </div>

  <div class="admin-table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Client Name</th>
          <th>Lead Type</th>
          <th>Contact Info</th>
          <th>Timeframe / Budget</th>
          <th>Language</th>
          <th>Status</th>
          <th>Received</th>
        </tr>
      </thead>
      <tbody>
        {leads.slice(0, 5).map(lead => (
          <tr>
            <td>
              <strong style="color: #ffffff;">{lead.full_name}</strong>
              {lead.property_address && <div style="font-size: 0.75rem; color: #8b9bb0;">Addr: {lead.property_address}</div>}
            </td>
            <td>
              <span class="badge badge-dark" style="font-size: 0.7rem;">
                {lead.lead_type.replace('_', ' ')}
              </span>
            </td>
            <td>
              <div>{lead.phone}</div>
              <div style="font-size: 0.78rem; color: #8b9bb0;">{lead.email}</div>
            </td>
            <td>
              <div>{lead.timeframe || 'Not specified'}</div>
              {lead.estimated_budget && <div style="font-size: 0.78rem; color: #c5a059;">{lead.estimated_budget}</div>}
            </td>
            <td>
              <span style="text-transform: uppercase; font-weight: 700; font-size: 0.75rem;">
                {lead.language_preference || 'en'}
              </span>
            </td>
            <td>
              <span class:list={[
                'badge',
                lead.status === 'new' ? 'badge-gold' :
                lead.status === 'contacted' ? 'badge-blue' : 'badge-emerald'
              ]}>
                {lead.status}
              </span>
            </td>
            <td style="font-size: 0.8rem; color: #8b9bb0;">
              {new Date(lead.created_at).toLocaleDateString()}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
