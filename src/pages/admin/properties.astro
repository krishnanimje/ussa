---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getPropertiesPaginated, getPropertyStats, SITE_SETTINGS } from '../../lib/store';
import { formatCurrency } from '../../lib/mortgage';
import { checkAdminAuth } from '../../lib/auth';

export const prerender = false;

if (!checkAdminAuth(Astro.request)) {
  return Astro.redirect('/admin/login');
}

// Search & Filter parameters
const url = new URL(Astro.request.url);
const search = url.searchParams.get('search') || '';
const publicationStatus = url.searchParams.get('publicationStatus') || 'all';
const listingStatus = url.searchParams.get('listingStatus') || 'all';
const page = parseInt(url.searchParams.get('page') || '1', 10);
const pageSize = 12;

const paginatedResult = await getPropertiesPaginated({
  search: search || undefined,
  publicationStatus: publicationStatus !== 'all' ? publicationStatus : undefined,
  listingStatus: listingStatus !== 'all' ? listingStatus : undefined,
  page,
  pageSize,
  includeUnpublished: true,
  includeDeleted: false
});

const stats = await getPropertyStats();
---

<AdminLayout title="Properties" activeNav="properties">
  <!-- Header -->
  <div class="admin-header" style="flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.85rem; margin: 0 0 0.25rem 0; color: #ffffff;">Property Listings</h1>
      <p style="color: var(--admin-text-muted); margin: 0; font-size: 0.9rem;">
        Add, edit, and manage all your real estate listings for {SITE_SETTINGS.brokerage_name}.
      </p>
    </div>
    <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
      <a href="/properties" target="_blank" class="btn btn-outline-white btn-sm">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        View Public Site
      </a>
      <a href="/admin/properties/new" class="btn btn-gold btn-sm" style="font-weight: 700;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
        + Add New Property
      </a>
    </div>
  </div>

  <!-- Quick KPI Counters -->
  <div class="admin-kpi-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 1.75rem;">
    <div class="kpi-card" style="padding: 1.25rem;">
      <div class="kpi-title">Total Listings</div>
      <div class="kpi-value">{stats.total}</div>
      <span style="font-size: 0.8rem; color: var(--admin-text-muted);">Active in catalog</span>
    </div>

    <div class="kpi-card" style="padding: 1.25rem; border-top: 3px solid #10b981;">
      <div class="kpi-title">Published (Live)</div>
      <div class="kpi-value" style="color: #10b981;">{stats.published}</div>
      <span style="font-size: 0.8rem; color: #10b981;">Visible on public website</span>
    </div>

    <div class="kpi-card" style="padding: 1.25rem; border-top: 3px solid #f59e0b;">
      <div class="kpi-title">Drafts</div>
      <div class="kpi-value" style="color: #f59e0b;">{stats.draft}</div>
      <span style="font-size: 0.8rem; color: #f59e0b;">Hidden from visitors</span>
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="card" style="padding: 1.25rem; background: var(--admin-surface); border: 1px solid var(--admin-border); margin-bottom: 1.5rem;">
    <form method="GET" action="/admin/properties" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end;">
      <!-- Search -->
      <div style="flex: 2; min-width: 240px;">
        <label style="display: block; font-size: 0.75rem; color: var(--admin-text-muted); text-transform: uppercase; font-weight: 600; margin-bottom: 0.35rem;">Search</label>
        <input 
          type="text" 
          name="search" 
          value={search} 
          placeholder="Search by title, address, neighborhood..." 
          class="form-input"
          style="height: 38px;"
        />
      </div>

      <!-- Publication Status -->
      <div style="flex: 1; min-width: 160px;">
        <label style="display: block; font-size: 0.75rem; color: var(--admin-text-muted); text-transform: uppercase; font-weight: 600; margin-bottom: 0.35rem;">Publication</label>
        <select name="publicationStatus" class="form-select" style="height: 38px;">
          <option value="all" selected={publicationStatus === 'all'}>All Statuses</option>
          <option value="published" selected={publicationStatus === 'published'}>Published Only</option>
          <option value="draft" selected={publicationStatus === 'draft'}>Drafts Only</option>
        </select>
      </div>

      <!-- Listing Status -->
      <div style="flex: 1; min-width: 160px;">
        <label style="display: block; font-size: 0.75rem; color: var(--admin-text-muted); text-transform: uppercase; font-weight: 600; margin-bottom: 0.35rem;">Market State</label>
        <select name="listingStatus" class="form-select" style="height: 38px;">
          <option value="all" selected={listingStatus === 'all'}>All States</option>
          <option value="for_sale" selected={listingStatus === 'for_sale'}>For Sale</option>
          <option value="pending" selected={listingStatus === 'pending'}>Pending / Under Contract</option>
          <option value="sold" selected={listingStatus === 'sold'}>Sold</option>
          <option value="for_rent" selected={listingStatus === 'for_rent'}>For Rent</option>
        </select>
      </div>

      <!-- Buttons -->
      <div style="display: flex; gap: 0.5rem;">
        <button type="submit" class="btn btn-gold btn-sm" style="height: 38px; padding: 0 1.25rem;">Filter</button>
        {search || publicationStatus !== 'all' || listingStatus !== 'all' ? (
          <a href="/admin/properties" class="btn btn-outline-white btn-sm" style="height: 38px;">Reset</a>
        ) : null}
      </div>
    </form>
  </div>

  <!-- Properties Table -->
  <div class="admin-table-container">
    {paginatedResult.properties.length === 0 ? (
      <div style="padding: 4rem 2rem; text-align: center;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--admin-text-muted); margin-bottom: 1rem;"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <h3 style="color: #ffffff; margin-bottom: 0.5rem;">No properties found</h3>
        <p style="color: var(--admin-text-muted); max-width: 400px; margin: 0 auto 1.5rem auto; font-size: 0.9rem;">
          Try adjusting your search filters or click below to add your first property.
        </p>
        <a href="/admin/properties/new" class="btn btn-gold btn-sm">+ Add New Property</a>
      </div>
    ) : (
      <table class="admin-table">
        <thead>
          <tr>
            <th style="width: 70px;">Photo</th>
            <th>Property &amp; Location</th>
            <th>Price</th>
            <th>Details</th>
            <th>Status</th>
            <th style="text-align: right; min-width: 140px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          {paginatedResult.properties.map(p => (
            <tr id={`row-${p.id}`}>
              <!-- Thumbnail -->
              <td style="width: 70px;">
                <a href={`/admin/properties/edit?id=${p.id}`}>
                  <img 
                    src={p.primary_image || '/images/properties/north-park-spanish.svg'} 
                    alt={p.title} 
                    width="64" 
                    height="44" 
                    style="border-radius: 4px; object-fit: cover; display: block; border: 1px solid var(--admin-border);" 
                  />
                </a>
              </td>

              <!-- Title & Location -->
              <td>
                <a href={`/admin/properties/edit?id=${p.id}`} style="color: #ffffff; font-weight: 700; text-decoration: none; font-size: 0.95rem;">
                  {p.title}
                </a>
                <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-top: 3px;">
                  {p.neighborhood}, {p.address_city} {p.address_street ? `• ${p.address_street}` : ''}
                </div>
              </td>

              <!-- Price -->
              <td>
                <strong style="color: var(--color-gold-400); font-size: 1rem;">
                  {formatCurrency(p.price)}
                </strong>
                {p.listing_status && p.listing_status !== 'for_sale' && (
                  <div style="font-size: 0.72rem; text-transform: uppercase; color: #94a3b8; margin-top: 2px;">
                    {p.listing_status.replace('_', ' ')}
                  </div>
                )}
              </td>

              <!-- Details -->
              <td style="font-size: 0.85rem; color: #cbd5e1;">
                <div>{p.property_type}</div>
                <div style="font-size: 0.78rem; color: var(--admin-text-muted);">
                  {p.bedrooms} Beds • {p.bathrooms} Baths • {p.square_feet.toLocaleString()} sq ft
                </div>
              </td>

              <!-- Status Badge & 1-Click Toggle -->
              <td>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <span class:list={[
                    'badge',
                    p.publication_status === 'published' ? 'badge-emerald' : 'badge-gold'
                  ]}>
                    {p.publication_status === 'published' ? '● Published' : '○ Draft'}
                  </span>
                  
                  <button 
                    type="button" 
                    class="btn-icon btn-toggle-status" 
                    data-id={p.id} 
                    data-action={p.publication_status === 'published' ? 'unpublish' : 'publish'}
                    title={p.publication_status === 'published' ? 'Click to make Draft' : 'Click to Publish live'}
                    style="font-size: 0.72rem; padding: 2px 6px;"
                  >
                    {p.publication_status === 'published' ? 'Hide' : 'Publish'}
                  </button>
                </div>
              </td>

              <!-- Actions -->
              <td style="text-align: right; white-space: nowrap;">
                <div style="display: inline-flex; gap: 0.4rem; align-items: center;">
                  <!-- Edit Button -->
                  <a href={`/admin/properties/edit?id=${p.id}`} class="btn btn-outline-white btn-sm" style="padding: 0.35rem 0.65rem;" title="Edit Property">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 3px; vertical-align: -1px;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    Edit
                  </a>

                  <!-- View on Site Button -->
                  <a href={`/properties/${p.slug}`} target="_blank" class="btn-icon" title="View Public Listing">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                  </a>

                  <!-- Delete Button -->
                  <button 
                    type="button" 
                    class="btn-icon btn-delete-prop" 
                    data-id={p.id} 
                    data-title={p.title}
                    title="Delete Property" 
                    style="color: #ef4444;"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    <!-- Simple Pagination -->
    {paginatedResult.totalPages > 1 && (
      <div style="padding: 1.25rem; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--admin-border); background: #0c131a; font-size: 0.85rem;">
        <span style="color: var(--admin-text-muted);">
          Page {paginatedResult.page} of {paginatedResult.totalPages} ({paginatedResult.total} Total)
        </span>
        <div style="display: flex; gap: 0.5rem;">
          {paginatedResult.page > 1 && (
            <a href={`/admin/properties?page=${paginatedResult.page - 1}&search=${encodeURIComponent(search)}&publicationStatus=${publicationStatus}&listingStatus=${listingStatus}`} class="btn btn-outline-white btn-sm">
              &larr; Prev
            </a>
          )}
          {paginatedResult.page < paginatedResult.totalPages && (
            <a href={`/admin/properties?page=${paginatedResult.page + 1}&search=${encodeURIComponent(search)}&publicationStatus=${publicationStatus}&listingStatus=${listingStatus}`} class="btn btn-outline-white btn-sm">
              Next &rarr;
            </a>
          )}
        </div>
      </div>
    )}
  </div>

  <!-- Delete Confirmation Modal -->
  <div id="deleteModal" class="admin-modal-overlay" style="display: none;">
    <div class="admin-modal">
      <div class="admin-modal-header">
        <h3 style="margin: 0; color: #ef4444; font-size: 1.15rem;">Delete Property</h3>
        <button type="button" class="btn-modal-close" style="background: none; border: none; color: #fff; font-size: 1.5rem; cursor: pointer;">&times;</button>
      </div>
      <div class="admin-modal-body">
        <p style="margin: 0 0 1rem 0; color: #f1f5f9; font-size: 0.95rem;">
          Are you sure you want to delete <strong id="deleteTargetTitle" style="color: #ffffff;"></strong>?
        </p>
        <p style="margin: 0; font-size: 0.82rem; color: var(--admin-text-muted);">
          This listing will be archived and removed from your active website.
        </p>
      </div>
      <div class="admin-modal-footer">
        <button type="button" class="btn btn-outline-white btn-sm btn-modal-cancel">Cancel</button>
        <button type="button" id="confirmDeleteBtn" class="btn btn-danger btn-sm">Delete</button>
      </div>
    </div>
  </div>

  <!-- Toast Notifications -->
  <div id="adminToastContainer" class="admin-toast-container"></div>
</AdminLayout>

<script>
  function setupPropertiesList() {
    const toastContainer = document.getElementById('adminToastContainer');
    const deleteModal = document.getElementById('deleteModal');
    const deleteTargetTitle = document.getElementById('deleteTargetTitle');
    const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
    let targetPropertyId = '';

    function showToast(msg: string, type: 'success' | 'error' = 'success') {
      if (!toastContainer) {
        alert(msg);
        return;
      }
      const toast = document.createElement('div');
      toast.className = `admin-toast ${type}`;
      toast.textContent = msg;
      toastContainer.appendChild(toast);
      setTimeout(() => toast.remove(), 4000);
    }

    // Toggle Published / Draft status
    document.querySelectorAll('.btn-toggle-status').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const action = btn.getAttribute('data-action');
        if (!id || !action) return;

        (btn as HTMLButtonElement).disabled = true;
        try {
          const res = await fetch('/api/admin/properties/status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, action })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            showToast(`Property is now ${action === 'publish' ? 'published' : 'draft'}!`);
            setTimeout(() => window.location.reload(), 700);
          } else {
            showToast(data.error || 'Failed to update status', 'error');
            (btn as HTMLButtonElement).disabled = false;
          }
        } catch (e: any) {
          showToast('Network error: ' + e.message, 'error');
          (btn as HTMLButtonElement).disabled = false;
        }
      });
    });

    // Delete modal trigger
    document.querySelectorAll('.btn-delete-prop').forEach(btn => {
      btn.addEventListener('click', () => {
        targetPropertyId = btn.getAttribute('data-id') || '';
        const title = btn.getAttribute('data-title') || 'this property';
        if (deleteTargetTitle) deleteTargetTitle.textContent = `"${title}"`;
        if (deleteModal) deleteModal.style.display = 'flex';
      });
    });

    // Close modal
    function closeModal() {
      if (deleteModal) deleteModal.style.display = 'none';
      targetPropertyId = '';
    }
    document.querySelectorAll('.btn-modal-close, .btn-modal-cancel').forEach(btn => {
      btn.addEventListener('click', closeModal);
    });

    // Confirm Delete
    if (confirmDeleteBtn) {
      confirmDeleteBtn.addEventListener('click', async () => {
        if (!targetPropertyId) return;
        confirmDeleteBtn.setAttribute('disabled', 'true');
        try {
          const res = await fetch(`/api/admin/properties?id=${targetPropertyId}`, {
            method: 'DELETE'
          });
          const data = await res.json();
          if (res.ok && data.success) {
            showToast('Property deleted successfully!');
            const row = document.getElementById(`row-${targetPropertyId}`);
            if (row) row.remove();
            closeModal();
          } else {
            showToast(data.error || 'Failed to delete property', 'error');
          }
        } catch (e: any) {
          showToast('Network error: ' + e.message, 'error');
        } finally {
          confirmDeleteBtn.removeAttribute('disabled');
        }
      });
    }
  }

  document.addEventListener('astro:page-load', setupPropertiesList);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupPropertiesList();
  }
</script>
