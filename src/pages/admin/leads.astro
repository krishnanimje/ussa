---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllLeads } from '../../lib/store';
import { checkAdminAuth } from '../../lib/auth';

export const prerender = false;

if (!checkAdminAuth(Astro.request)) {
  return Astro.redirect('/admin/login');
}

const leads = await getAllLeads();

// Calculate status counts
const counts = {
  all: leads.length,
  new: leads.filter(l => l.status === 'new').length,
  contacted: leads.filter(l => l.status === 'contacted').length,
  qualified: leads.filter(l => l.status === 'qualified').length,
  appointment_scheduled: leads.filter(l => l.status === 'appointment_scheduled' || (l.status as string) === 'appointment_set').length,
  in_progress: leads.filter(l => l.status === 'in_progress').length,
  converted: leads.filter(l => l.status === 'converted' || (l.status as string) === 'closed').length,
  lost: leads.filter(l => l.status === 'lost' || (l.status as string) === 'archived').length,
  spam: leads.filter(l => l.status === 'spam').length
};

// Check for overdue follow-ups
const nowTime = Date.now();
const overdueCount = leads.filter(l => l.follow_up_date && new Date(l.follow_up_date).getTime() < nowTime && l.status !== 'converted' && l.status !== 'lost' && l.status !== 'spam').length;
---

<AdminLayout title="Inquiries & CRM" activeNav="leads">
  <!-- Header -->
  <div class="admin-header" style="flex-wrap: wrap; gap: 1rem;">
    <div>
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
        <h1 style="font-size: 1.85rem; margin: 0; color: #ffffff;">CRM &amp; Client Inquiries Workspace</h1>
        <span class="badge badge-gold" style="font-size: 0.72rem; text-transform: uppercase;">
          Full Lifecycle CRM
        </span>
      </div>
      <p style="color: var(--admin-text-muted); margin: 0; font-size: 0.9rem;">
        Securely managing private client inquiries, follow-up reminders, and internal notes.
      </p>
    </div>

    <!-- Actions / Export -->
    <div style="display: flex; gap: 0.75rem; align-items: center;">
      <a href="/api/admin/reports/export?type=leads_by_date" class="btn btn-gold btn-sm" style="display: inline-flex; align-items: center; gap: 0.4rem;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        Export Leads CSV
      </a>
    </div>
  </div>

  <!-- KPI / Status Counter Ribbon -->
  <div class="admin-kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); margin-bottom: 1.75rem;">
    <div class="kpi-card" style="padding: 1rem;">
      <div class="kpi-title">Total Leads</div>
      <div class="kpi-value">{counts.all}</div>
    </div>
    <div class="kpi-card" style="padding: 1rem; border-top: 3px solid #38bdf8;">
      <div class="kpi-title">New Inquiries</div>
      <div class="kpi-value" style="color: #38bdf8;">{counts.new}</div>
    </div>
    <div class="kpi-card" style="padding: 1rem; border-top: 3px solid #f59e0b;">
      <div class="kpi-title">Contacted</div>
      <div class="kpi-value" style="color: #f59e0b;">{counts.contacted}</div>
    </div>
    <div class="kpi-card" style="padding: 1rem; border-top: 3px solid #10b981;">
      <div class="kpi-title">Qualified</div>
      <div class="kpi-value" style="color: #10b981;">{counts.qualified}</div>
    </div>
    <div class="kpi-card" style="padding: 1rem; border-top: 3px solid #a855f7;">
      <div class="kpi-title">Appt Scheduled</div>
      <div class="kpi-value" style="color: #c084fc;">{counts.appointment_scheduled}</div>
    </div>
    <div class="kpi-card" style="padding: 1rem; border-top: 3px solid var(--color-gold-400);">
      <div class="kpi-title">In Progress</div>
      <div class="kpi-value" style="color: var(--color-gold-400);">{counts.in_progress}</div>
    </div>
    <div class="kpi-card" style="padding: 1rem; border-top: 3px solid #34d399;">
      <div class="kpi-title">Converted / Closed</div>
      <div class="kpi-value" style="color: #34d399;">{counts.converted}</div>
    </div>
    <div class="kpi-card" style="padding: 1rem; border-top: 3px solid #ef4444;">
      <div class="kpi-title">Overdue Follow-ups</div>
      <div class="kpi-value" style="color: #ef4444;">{overdueCount}</div>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="card" style="padding: 1.25rem; background: var(--admin-surface); border: 1px solid var(--admin-border); margin-bottom: 1.75rem;">
    <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
      <!-- Search Input -->
      <div style="flex: 1; min-width: 260px;">
        <input 
          type="text" 
          id="crmSearchInput" 
          placeholder="Search client name, email, phone, message, or property address..." 
          style="width: 100%; box-sizing: border-box; background: #090e14; border: 1px solid #1e2c3c; border-radius: 6px; padding: 0.65rem 1rem; color: #ffffff; font-size: 0.9rem;"
        />
      </div>

      <!-- Quick Filter Toggles -->
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <button class="lead-filter-btn active" data-status="all">All ({counts.all})</button>
        <button class="lead-filter-btn" data-status="new">New ({counts.new})</button>
        <button class="lead-filter-btn" data-status="contacted">Contacted ({counts.contacted})</button>
        <button class="lead-filter-btn" data-status="qualified">Qualified ({counts.qualified})</button>
        <button class="lead-filter-btn" data-status="appointment_scheduled">Appts ({counts.appointment_scheduled})</button>
        <button class="lead-filter-btn" data-status="in_progress">In Progress ({counts.in_progress})</button>
        <button class="lead-filter-btn" data-status="converted">Converted ({counts.converted})</button>
        <button class="lead-filter-btn" data-status="lost">Lost ({counts.lost})</button>
        <button class="lead-filter-btn" data-status="spam">Spam ({counts.spam})</button>
      </div>
    </div>
  </div>

  <!-- CRM Leads Table -->
  <div class="admin-table-container">
    <table class="admin-table" id="crmLeadsTable">
      <thead>
        <tr>
          <th>Client &amp; Contact</th>
          <th>Type &amp; Property</th>
          <th>Status</th>
          <th>Follow-Up Date</th>
          <th>Budget / Timeframe</th>
          <th>Source / Campaign</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {leads.map(lead => {
          const isOverdue = lead.follow_up_date && new Date(lead.follow_up_date).getTime() < nowTime && lead.status !== 'converted' && lead.status !== 'lost' && lead.status !== 'spam';
          return (
            <tr class="lead-crm-row" data-lead-id={lead.id} data-status={lead.status} data-type={lead.lead_type}>
              <td>
                <div style="font-weight: 700; color: #ffffff; font-size: 0.95rem;">
                  {lead.full_name}
                </div>
                <div style="font-size: 0.8rem; margin-top: 0.2rem;">
                  <a href={`tel:${lead.phone}`} style="color: #38bdf8; text-decoration: none;">{lead.phone}</a>
                  <span style="color: #64748b; margin: 0 0.35rem;">•</span>
                  <a href={`mailto:${lead.email}`} style="color: #8b9bb0; text-decoration: none;">{lead.email}</a>
                </div>
                <div style="font-size: 0.72rem; color: #64748b; margin-top: 0.15rem;">
                  ID: {lead.id} • Created {new Date(lead.created_at).toLocaleDateString()}
                </div>
              </td>

              <td>
                <span class="badge badge-dark" style="font-size: 0.72rem; border-color: var(--color-gold-500); text-transform: capitalize;">
                  {lead.lead_type.replace(/_/g, ' ')}
                </span>
                {lead.property_address && (
                  <div style="font-size: 0.78rem; color: var(--color-gold-400); margin-top: 0.3rem;">
                    {lead.property_address}
                  </div>
                )}
                {lead.property_id && (
                  <a href={`/properties/${lead.property_id}`} target="_blank" style="font-size: 0.72rem; color: #38bdf8;">
                    View Property &rarr;
                  </a>
                )}
              </td>

              <td>
                <select class="crm-inline-status" data-lead-id={lead.id} style="background: #090e14; color: #ffffff; border: 1px solid #1e2c3c; padding: 0.35rem 0.6rem; border-radius: 4px; font-size: 0.8rem; cursor: pointer;">
                  <option value="new" selected={lead.status === 'new'}>New</option>
                  <option value="contacted" selected={lead.status === 'contacted'}>Contacted</option>
                  <option value="qualified" selected={lead.status === 'qualified'}>Qualified</option>
                  <option value="appointment_scheduled" selected={lead.status === 'appointment_scheduled' || (lead.status as string) === 'appointment_set'}>Appointment Set</option>
                  <option value="in_progress" selected={lead.status === 'in_progress'}>In Progress</option>
                  <option value="converted" selected={lead.status === 'converted' || (lead.status as string) === 'closed'}>Converted</option>
                  <option value="lost" selected={lead.status === 'lost' || (lead.status as string) === 'archived'}>Lost</option>
                  <option value="spam" selected={lead.status === 'spam'}>Spam</option>
                </select>
              </td>

              <td>
                {lead.follow_up_date ? (
                  <div>
                    <span class:list={['badge', isOverdue ? 'badge-archived' : 'badge-draft']} style={`font-size: 0.75rem; ${isOverdue ? 'color: #f87171; border-color: #ef4444;' : ''}`}>
                      {new Date(lead.follow_up_date).toLocaleDateString()}
                    </span>
                    {isOverdue && <div style="font-size: 0.7rem; color: #ef4444; font-weight: 600; margin-top: 0.2rem;">Overdue</div>}
                  </div>
                ) : (
                  <span style="font-size: 0.78rem; color: #64748b;">Not scheduled</span>
                )}
              </td>

              <td>
                <div style="font-size: 0.82rem; color: #ffffff;">{lead.estimated_budget || 'Budget unstated'}</div>
                <div style="font-size: 0.75rem; color: #94a3b8;">{lead.timeframe || 'Timeframe open'}</div>
              </td>

              <td>
                <div style="font-size: 0.78rem; color: #cbd5e1;">{lead.source_page || '/contact'}</div>
                {lead.utm_source && (
                  <div style="font-size: 0.72rem; color: var(--color-gold-400);">
                    UTM: {lead.utm_source} / {lead.utm_medium || 'none'}
                  </div>
                )}
              </td>

              <td style="text-align: right;">
                <button class="btn btn-outline-white btn-sm open-lead-drawer-btn" data-lead={JSON.stringify(lead)} style="padding: 0.35rem 0.65rem; font-size: 0.75rem;">
                  CRM Details
                </button>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <!-- Lead Detail & Notes Drawer Modal -->
  <dialog id="leadDrawerModal" style="background: #101923; border: 1px solid #1e2c3c; border-radius: 12px; color: #ffffff; max-width: 680px; width: 90%; padding: 2rem; box-shadow: 0 25px 50px rgba(0,0,0,0.6);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid #1e2c3c; padding-bottom: 1rem;">
      <div>
        <h2 id="modalLeadName" style="margin: 0 0 0.25rem 0; font-size: 1.35rem; color: #ffffff;">Client Name</h2>
        <span id="modalLeadMeta" style="font-size: 0.8rem; color: #94a3b8;">ID: lead-000</span>
      </div>
      <button id="closeLeadDrawerBtn" style="background: none; border: none; color: #94a3b8; font-size: 1.6rem; cursor: pointer;">&times;</button>
    </div>

    <!-- Contact & Status Row -->
    <div class="grid-2" style="gap: 1.5rem; margin-bottom: 1.5rem;">
      <div style="background: #090e14; border: 1px solid #1e2c3c; border-radius: 6px; padding: 1rem;">
        <h4 style="margin: 0 0 0.5rem 0; font-size: 0.85rem; color: var(--color-gold-400);">Contact Details</h4>
        <div id="modalLeadPhone" style="font-size: 0.9rem; margin-bottom: 0.3rem;">Phone: (619) 555-0000</div>
        <div id="modalLeadEmail" style="font-size: 0.9rem; margin-bottom: 0.3rem;">Email: client@domain.com</div>
        <div id="modalLeadPref" style="font-size: 0.78rem; color: #94a3b8;">Prefers: Phone</div>
      </div>

      <div style="background: #090e14; border: 1px solid #1e2c3c; border-radius: 6px; padding: 1rem;">
        <h4 style="margin: 0 0 0.5rem 0; font-size: 0.85rem; color: var(--color-gold-400);">Status &amp; Follow-up</h4>
        <div style="margin-bottom: 0.6rem;">
          <label style="display: block; font-size: 0.72rem; color: #94a3b8; margin-bottom: 0.2rem;">Lifecycle Status</label>
          <select id="modalStatusSelect" style="width: 100%; background: #101923; color: #ffffff; border: 1px solid #1e2c3c; padding: 0.4rem; border-radius: 4px; font-size: 0.85rem;">
            <option value="new">New</option>
            <option value="contacted">Contacted</option>
            <option value="qualified">Qualified</option>
            <option value="appointment_scheduled">Appointment Scheduled</option>
            <option value="in_progress">In Progress</option>
            <option value="converted">Converted / Closed</option>
            <option value="lost">Lost</option>
            <option value="spam">Spam</option>
          </select>
        </div>

        <div>
          <label style="display: block; font-size: 0.72rem; color: #94a3b8; margin-bottom: 0.2rem;">Next Follow-Up Date</label>
          <input type="date" id="modalFollowUpDate" style="width: 100%; box-sizing: border-box; background: #101923; color: #ffffff; border: 1px solid #1e2c3c; padding: 0.4rem; border-radius: 4px; font-size: 0.85rem;" />
        </div>
      </div>
    </div>

    <!-- Client Message -->
    <div style="margin-bottom: 1.5rem;">
      <h4 style="margin: 0 0 0.5rem 0; font-size: 0.85rem; color: #cbd5e1;">Client Message / Inquiry Request</h4>
      <div id="modalLeadMessage" style="background: #090e14; border: 1px solid #1e2c3c; border-radius: 6px; padding: 1rem; font-size: 0.88rem; color: #cbd5e1; line-height: 1.5;">
        Message text goes here...
      </div>
    </div>

    <!-- Internal Notes Thread -->
    <div style="margin-bottom: 1.5rem;">
      <h4 style="margin: 0 0 0.5rem 0; font-size: 0.85rem; color: var(--color-gold-400);">Internal Notes &amp; Follow-up History</h4>
      <div id="modalNotesList" style="max-height: 160px; overflow-y: auto; display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0.75rem;">
        <!-- Dynamically populated notes -->
      </div>

      <div style="display: flex; gap: 0.5rem;">
        <input type="text" id="modalNewNoteInput" placeholder="Add confidential internal note..." style="flex: 1; background: #090e14; border: 1px solid #1e2c3c; border-radius: 4px; padding: 0.5rem 0.75rem; color: #ffffff; font-size: 0.85rem;" />
        <button id="modalAddNoteBtn" class="btn btn-gold btn-sm">Add Note</button>
      </div>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #1e2c3c; padding-top: 1rem;">
      <button id="modalDeleteLeadBtn" class="btn btn-outline-white btn-sm" style="color: #f87171; border-color: rgba(248,113,113,0.3);">
        Delete Lead
      </button>
      <button id="modalSaveLeadBtn" class="btn btn-gold btn-sm">
        Save Changes
      </button>
    </div>
  </dialog>
</AdminLayout>

<script is:inline>
  var activeLead = null;

  // Search and Filtering
  var searchInput = document.getElementById('crmSearchInput');
  var filterButtons = document.querySelectorAll('.lead-filter-btn');
  var rows = document.querySelectorAll('.lead-crm-row');

  function applyFilters() {
    var query = searchInput ? searchInput.value.toLowerCase().trim() : '';
    var activeBtn = document.querySelector('.lead-filter-btn.active');
    var targetStatus = activeBtn ? activeBtn.getAttribute('data-status') : 'all';

    rows.forEach(function(row) {
      var rowStatus = row.getAttribute('data-status');
      var rowText = row.textContent.toLowerCase();

      var matchesQuery = !query || rowText.includes(query);
      var matchesStatus = targetStatus === 'all' || rowStatus === targetStatus;

      row.style.display = matchesQuery && matchesStatus ? '' : 'none';
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', applyFilters);
  }

  filterButtons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      filterButtons.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      applyFilters();
    });
  });

  // Inline Status Changer
  document.querySelectorAll('.crm-inline-status').forEach(function(select) {
    select.addEventListener('change', async function() {
      var leadId = select.getAttribute('data-lead-id');
      var newStatus = select.value;
      try {
        var res = await fetch('/api/admin/leads', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ leadId: leadId, status: newStatus })
        });
        if (res.ok) {
          var row = select.closest('tr');
          if (row) row.setAttribute('data-status', newStatus);
        } else {
          alert('Could not update lead status');
        }
      } catch (err) {
        alert('Network error updating status');
      }
    });
  });

  // Lead Drawer Modal
  var drawer = document.getElementById('leadDrawerModal');
  var closeDrawerBtn = document.getElementById('closeLeadDrawerBtn');

  document.querySelectorAll('.open-lead-drawer-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var leadData = JSON.parse(btn.getAttribute('data-lead'));
      activeLead = leadData;

      document.getElementById('modalLeadName').textContent = leadData.full_name;
      document.getElementById('modalLeadMeta').textContent = 'ID: ' + leadData.id + ' • Source: ' + (leadData.source_page || 'Website');
      document.getElementById('modalLeadPhone').innerHTML = '<strong>Phone:</strong> <a href="tel:' + leadData.phone + '" style="color:#38bdf8;">' + leadData.phone + '</a>';
      document.getElementById('modalLeadEmail').innerHTML = '<strong>Email:</strong> <a href="mailto:' + leadData.email + '" style="color:#8b9bb0;">' + leadData.email + '</a>';
      document.getElementById('modalLeadPref').textContent = 'Preferred Contact: ' + (leadData.preferred_contact_method || 'Phone');
      document.getElementById('modalStatusSelect').value = leadData.status;
      document.getElementById('modalFollowUpDate').value = leadData.follow_up_date ? leadData.follow_up_date.split('T')[0] : '';
      document.getElementById('modalLeadMessage').textContent = leadData.message || 'No additional client message provided.';

      renderNotes(leadData.notes || []);
      drawer.showModal();
    });
  });

  function renderNotes(notes) {
    var notesList = document.getElementById('modalNotesList');
    if (!notes || notes.length === 0) {
      notesList.innerHTML = '<div style="font-size:0.78rem;color:#64748b;font-style:italic;">No internal notes logged yet.</div>';
      return;
    }
    notesList.innerHTML = notes.map(function(n) {
      return '<div style="background:#090e14;border:1px solid #1e2c3c;border-radius:4px;padding:0.5rem 0.75rem;font-size:0.8rem;">' +
        '<div style="color:#ffffff;line-height:1.4;">' + n.note + '</div>' +
        '<div style="font-size:0.7rem;color:#64748b;margin-top:0.25rem;">' + n.author_email + ' • ' + new Date(n.created_at).toLocaleString() + '</div>' +
      '</div>';
    }).join('');
  }

  if (closeDrawerBtn && drawer) {
    closeDrawerBtn.addEventListener('click', function() { drawer.close(); });
    drawer.addEventListener('click', function(e) { if (e.target === drawer) drawer.close(); });
  }

  // Add Note Button
  var addNoteBtn = document.getElementById('modalAddNoteBtn');
  var newNoteInput = document.getElementById('modalNewNoteInput');

  if (addNoteBtn && newNoteInput) {
    addNoteBtn.addEventListener('click', async function() {
      var noteText = newNoteInput.value.trim();
      if (!noteText || !activeLead) return;

      try {
        var res = await fetch('/api/admin/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'add_note', leadId: activeLead.id, note: noteText })
        });
        var data = await res.json();
        if (data.success && data.note) {
          if (!activeLead.notes) activeLead.notes = [];
          activeLead.notes.unshift(data.note);
          renderNotes(activeLead.notes);
          newNoteInput.value = '';
        }
      } catch (err) {
        alert('Error saving note');
      }
    });
  }

  // Save Changes in Modal
  var saveLeadBtn = document.getElementById('modalSaveLeadBtn');
  if (saveLeadBtn) {
    saveLeadBtn.addEventListener('click', async function() {
      if (!activeLead) return;
      var newStatus = document.getElementById('modalStatusSelect').value;
      var newDate = document.getElementById('modalFollowUpDate').value;

      try {
        var res = await fetch('/api/admin/leads', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            leadId: activeLead.id,
            status: newStatus,
            follow_up_date: newDate ? new Date(newDate).toISOString() : null
          })
        });
        if (res.ok) {
          drawer.close();
          window.location.reload();
        } else {
          alert('Error updating lead');
        }
      } catch (e) {
        alert('Network error updating lead');
      }
    });
  }

  // Delete Lead Button
  var deleteLeadBtn = document.getElementById('modalDeleteLeadBtn');
  if (deleteLeadBtn) {
    deleteLeadBtn.addEventListener('click', async function() {
      if (!activeLead) return;
      if (!confirm('Are you sure you want to permanently delete lead for ' + activeLead.full_name + '?')) return;

      try {
        var res = await fetch('/api/admin/leads?id=' + encodeURIComponent(activeLead.id), {
          method: 'DELETE'
        });
        if (res.ok) {
          drawer.close();
          window.location.reload();
        } else {
          alert('Error deleting lead');
        }
      } catch (e) {
        alert('Network error deleting lead');
      }
    });
  }
</script>
