---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAllLeads } from '../../lib/store';
import { checkAdminAuth } from '../../lib/auth';

export const prerender = false;

if (!checkAdminAuth(Astro.request)) {
  return Astro.redirect('/admin/login');
}

const url = new URL(Astro.request.url);
const search = (url.searchParams.get('search') || '').toLowerCase().trim();
const statusFilter = url.searchParams.get('status') || 'all';

const allLeads = await getAllLeads();

const filteredLeads = allLeads.filter(lead => {
  const matchesSearch = !search || 
    lead.full_name.toLowerCase().includes(search) ||
    lead.email.toLowerCase().includes(search) ||
    lead.phone.toLowerCase().includes(search) ||
    (lead.property_address && lead.property_address.toLowerCase().includes(search)) ||
    (lead.message && lead.message.toLowerCase().includes(search));

  const matchesStatus = statusFilter === 'all' || lead.status === statusFilter;

  return matchesSearch && matchesStatus;
});

const totalCount = allLeads.length;
const newCount = allLeads.filter(l => l.status === 'new').length;
const contactedCount = allLeads.filter(l => l.status === 'contacted').length;
---

<AdminLayout title="Client Inquiries" activeNav="leads">
  <!-- Header -->
  <div class="admin-header" style="flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.85rem; margin: 0 0 0.25rem 0; color: #ffffff;">Client Inquiries</h1>
      <p style="color: var(--admin-text-muted); margin: 0; font-size: 0.9rem;">
        View and manage inquiries submitted by prospective buyers and sellers.
      </p>
    </div>
    <div>
      <a href="/api/admin/reports/export?type=leads_by_date" class="btn btn-outline-white btn-sm">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px; vertical-align: -1px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        Export CSV
      </a>
    </div>
  </div>

  <!-- Summary KPI Cards -->
  <div class="admin-kpi-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 1.75rem;">
    <div class="kpi-card" style="padding: 1.25rem;">
      <div class="kpi-title">Total Inquiries</div>
      <div class="kpi-value">{totalCount}</div>
      <span style="font-size: 0.8rem; color: var(--admin-text-muted);">All submissions</span>
    </div>

    <div class="kpi-card" style="padding: 1.25rem; border-top: 3px solid #f59e0b;">
      <div class="kpi-title">New Inquiries</div>
      <div class="kpi-value" style="color: #f59e0b;">{newCount}</div>
      <span style="font-size: 0.8rem; color: #f59e0b;">Needs follow-up</span>
    </div>

    <div class="kpi-card" style="padding: 1.25rem; border-top: 3px solid #38bdf8;">
      <div class="kpi-title">Contacted</div>
      <div class="kpi-value" style="color: #38bdf8;">{contactedCount}</div>
      <span style="font-size: 0.8rem; color: #38bdf8;">In conversation</span>
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="card" style="padding: 1.25rem; background: var(--admin-surface); border: 1px solid var(--admin-border); margin-bottom: 1.5rem;">
    <form method="GET" action="/admin/leads" style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: flex-end;">
      <!-- Search -->
      <div style="flex: 2; min-width: 260px;">
        <label style="display: block; font-size: 0.75rem; color: var(--admin-text-muted); text-transform: uppercase; font-weight: 600; margin-bottom: 0.35rem;">Search Inquiries</label>
        <input 
          type="text" 
          name="search" 
          value={search} 
          placeholder="Search by name, email, phone, message..." 
          class="form-input"
          style="height: 38px;"
        />
      </div>

      <!-- Status Filter -->
      <div style="flex: 1; min-width: 180px;">
        <label style="display: block; font-size: 0.75rem; color: var(--admin-text-muted); text-transform: uppercase; font-weight: 600; margin-bottom: 0.35rem;">Status</label>
        <select name="status" class="form-select" style="height: 38px;">
          <option value="all" selected={statusFilter === 'all'}>All Statuses</option>
          <option value="new" selected={statusFilter === 'new'}>New Only</option>
          <option value="contacted" selected={statusFilter === 'contacted'}>Contacted</option>
          <option value="qualified" selected={statusFilter === 'qualified'}>Qualified</option>
          <option value="converted" selected={statusFilter === 'converted'}>Converted</option>
        </select>
      </div>

      <!-- Buttons -->
      <div style="display: flex; gap: 0.5rem;">
        <button type="submit" class="btn btn-gold btn-sm" style="height: 38px; padding: 0 1.25rem;">Filter</button>
        {search || statusFilter !== 'all' ? (
          <a href="/admin/leads" class="btn btn-outline-white btn-sm" style="height: 38px;">Reset</a>
        ) : null}
      </div>
    </form>
  </div>

  <!-- Inquiries Table -->
  <div class="admin-table-container">
    {filteredLeads.length === 0 ? (
      <div style="padding: 4rem 2rem; text-align: center;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--admin-text-muted); margin-bottom: 1rem;"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        <h3 style="color: #ffffff; margin-bottom: 0.5rem;">No inquiries found</h3>
        <p style="color: var(--admin-text-muted); max-width: 400px; margin: 0 auto; font-size: 0.9rem;">
          Inquiries from the website contact and valuation forms will appear here automatically.
        </p>
      </div>
    ) : (
      <table class="admin-table">
        <thead>
          <tr>
            <th>Client Name</th>
            <th>Contact Details</th>
            <th>Interest / Type</th>
            <th>Message</th>
            <th>Received</th>
            <th>Status</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          {filteredLeads.map(lead => (
            <tr id={`lead-${lead.id}`}>
              <!-- Client Name -->
              <td>
                <strong style="color: #ffffff; font-size: 0.95rem;">{lead.full_name}</strong>
                {lead.property_address && (
                  <div style="font-size: 0.78rem; color: var(--color-gold-400); margin-top: 2px;">
                    🏠 {lead.property_address}
                  </div>
                )}
              </td>

              <!-- Phone & Email -->
              <td>
                <div>
                  <a href={`tel:${lead.phone}`} style="color: #38bdf8; text-decoration: none; font-weight: 600; font-size: 0.88rem;">
                    📞 {lead.phone}
                  </a>
                </div>
                <div style="margin-top: 2px;">
                  <a href={`mailto:${lead.email}`} style="color: #cbd5e1; text-decoration: none; font-size: 0.82rem;">
                    ✉️ {lead.email}
                  </a>
                </div>
              </td>

              <!-- Type -->
              <td>
                <span class="badge badge-dark" style="text-transform: capitalize;">
                  {(lead.lead_type || 'General').replace('_', ' ')}
                </span>
                {lead.estimated_budget && (
                  <div style="font-size: 0.75rem; color: var(--admin-text-muted); margin-top: 2px;">
                    Budget: {lead.estimated_budget}
                  </div>
                )}
              </td>

              <!-- Message -->
              <td style="max-width: 280px;">
                <div style="font-size: 0.85rem; color: #e2e8f0; line-height: 1.4; max-height: 60px; overflow-y: auto;">
                  {lead.message || <span style="color: var(--admin-text-muted); font-style: italic;">No message provided</span>}
                </div>
              </td>

              <!-- Date -->
              <td style="font-size: 0.82rem; color: var(--admin-text-muted); white-space: nowrap;">
                {new Date(lead.created_at).toLocaleDateString()}
              </td>

              <!-- Status Dropdown -->
              <td>
                <select 
                  class="form-select lead-status-select" 
                  data-id={lead.id}
                  style="font-size: 0.8rem; padding: 4px 8px; height: 32px; width: 130px;"
                >
                  <option value="new" selected={lead.status === 'new'}>🟡 New</option>
                  <option value="contacted" selected={lead.status === 'contacted'}>🔵 Contacted</option>
                  <option value="qualified" selected={lead.status === 'qualified'}>🟢 Qualified</option>
                  <option value="converted" selected={lead.status === 'converted'}>⭐ Converted</option>
                  <option value="lost" selected={lead.status === 'lost'}>⚪ Archived</option>
                </select>
              </td>

              <!-- Delete Button -->
              <td style="text-align: right; white-space: nowrap;">
                <button 
                  type="button" 
                  class="btn-icon btn-delete-lead" 
                  data-id={lead.id} 
                  data-name={lead.full_name}
                  title="Delete Inquiry" 
                  style="color: #ef4444;"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>

  <!-- Delete Modal -->
  <div id="deleteLeadModal" class="admin-modal-overlay" style="display: none;">
    <div class="admin-modal">
      <div class="admin-modal-header">
        <h3 style="margin: 0; color: #ef4444; font-size: 1.15rem;">Delete Inquiry</h3>
        <button type="button" class="btn-modal-close" style="background: none; border: none; color: #fff; font-size: 1.5rem; cursor: pointer;">&times;</button>
      </div>
      <div class="admin-modal-body">
        <p style="margin: 0 0 0.5rem 0; color: #f1f5f9;">
          Are you sure you want to delete inquiry from <strong id="deleteTargetLeadName" style="color: #fff;"></strong>?
        </p>
      </div>
      <div class="admin-modal-footer">
        <button type="button" class="btn btn-outline-white btn-sm btn-modal-cancel">Cancel</button>
        <button type="button" id="confirmDeleteLeadBtn" class="btn btn-danger btn-sm">Delete</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div id="leadsToastContainer" class="admin-toast-container"></div>
</AdminLayout>

<script>
  function setupLeadsManager() {
    const toastContainer = document.getElementById('leadsToastContainer');
    const deleteModal = document.getElementById('deleteLeadModal');
    const deleteTargetLeadName = document.getElementById('deleteTargetLeadName');
    const confirmDeleteBtn = document.getElementById('confirmDeleteLeadBtn');
    let targetLeadId = '';

    function showToast(msg: string, type: 'success' | 'error' = 'success') {
      if (!toastContainer) {
        alert(msg);
        return;
      }
      const toast = document.createElement('div');
      toast.className = `admin-toast ${type}`;
      toast.textContent = msg;
      toastContainer.appendChild(toast);
      setTimeout(() => toast.remove(), 4000);
    }

    // Status change
    document.querySelectorAll('.lead-status-select').forEach(select => {
      select.addEventListener('change', async () => {
        const leadId = select.getAttribute('data-id');
        const status = (select as HTMLSelectElement).value;
        if (!leadId) return;

        try {
          const res = await fetch('/api/admin/leads', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ leadId, status })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            showToast('Lead status updated!');
          } else {
            showToast(data.error || 'Failed to update status', 'error');
          }
        } catch (e: any) {
          showToast('Network error: ' + e.message, 'error');
        }
      });
    });

    // Delete trigger
    document.querySelectorAll('.btn-delete-lead').forEach(btn => {
      btn.addEventListener('click', () => {
        targetLeadId = btn.getAttribute('data-id') || '';
        const name = btn.getAttribute('data-name') || 'this client';
        if (deleteTargetLeadName) deleteTargetLeadName.textContent = name;
        if (deleteModal) deleteModal.style.display = 'flex';
      });
    });

    function closeModal() {
      if (deleteModal) deleteModal.style.display = 'none';
      targetLeadId = '';
    }

    document.querySelectorAll('.btn-modal-close, .btn-modal-cancel').forEach(btn => {
      btn.addEventListener('click', closeModal);
    });

    if (confirmDeleteBtn) {
      confirmDeleteBtn.addEventListener('click', async () => {
        if (!targetLeadId) return;
        confirmDeleteBtn.setAttribute('disabled', 'true');
        try {
          const res = await fetch(`/api/admin/leads?id=${targetLeadId}`, {
            method: 'DELETE'
          });
          const data = await res.json();
          if (res.ok && data.success) {
            showToast('Inquiry deleted successfully!');
            const row = document.getElementById(`lead-${targetLeadId}`);
            if (row) row.remove();
            closeModal();
          } else {
            showToast(data.error || 'Failed to delete inquiry', 'error');
          }
        } catch (e: any) {
          showToast('Network error: ' + e.message, 'error');
        } finally {
          confirmDeleteBtn.removeAttribute('disabled');
        }
      });
    }
  }

  document.addEventListener('astro:page-load', setupLeadsManager);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupLeadsManager();
  }
</script>
