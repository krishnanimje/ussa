---
import { generateSeoMetadata, generateAgentJsonLd, generateBreadcrumbJsonLd, generateVideoJsonLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  jsonLd?: string;
  hreflangEn?: string;
  hreflangEs?: string;
  noindex?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  video?: {
    name: string;
    description: string;
    thumbnailUrl: string;
    uploadDate: string;
    contentUrl?: string;
    embedUrl?: string;
  };
}

const { 
  title, 
  description, 
  image, 
  canonicalUrl, 
  type, 
  publishedTime, 
  jsonLd,
  hreflangEn,
  hreflangEs,
  noindex = false,
  breadcrumbs,
  video
} = Astro.props;

const meta = generateSeoMetadata({ title, description, image, canonicalUrl, type, publishedTime });
const defaultJsonLd = generateAgentJsonLd();
const siteUrl = 'https://edgarvalle.com';

const breadcrumbJsonLd = breadcrumbs && breadcrumbs.length > 0 ? generateBreadcrumbJsonLd(breadcrumbs) : null;
const videoJsonLd = video ? generateVideoJsonLd(video) : null;
---

<!-- Core Metadata -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="canonical" href={meta.canonicalUrl} />

<!-- Robots Directives -->
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

<!-- Bidirectional Hreflang Tags -->
{hreflangEn && (
  <link rel="alternate" hreflang="en" href={hreflangEn.startsWith('http') ? hreflangEn : `${siteUrl}${hreflangEn}`} />
)}
{hreflangEs && (
  <link rel="alternate" hreflang="es" href={hreflangEs.startsWith('http') ? hreflangEs : `${siteUrl}${hreflangEs}`} />
)}
{hreflangEn && (
  <link rel="alternate" hreflang="x-default" href={hreflangEn.startsWith('http') ? hreflangEn : `${siteUrl}${hreflangEn}`} />
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={meta.type} />
<meta property="og:site_name" content={meta.siteName} />
<meta property="og:url" content={meta.canonicalUrl} />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:image" content={meta.image} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={meta.canonicalUrl} />
<meta name="twitter:title" content={meta.title} />
<meta name="twitter:description" content={meta.description} />
<meta name="twitter:image" content={meta.image} />
<meta name="twitter:creator" content="@yourrealtoredgar" />

<!-- Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={defaultJsonLd} />
{breadcrumbJsonLd && <script type="application/ld+json" set:html={breadcrumbJsonLd} />}
{videoJsonLd && <script type="application/ld+json" set:html={videoJsonLd} />}
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
