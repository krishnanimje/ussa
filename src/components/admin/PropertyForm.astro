---
import type { Property } from '../../lib/types';
import { INITIAL_NEIGHBORHOODS, SITE_SETTINGS } from '../../lib/store';

interface Props {
  property?: Property;
  mode: 'create' | 'edit';
}

const { property, mode } = Astro.props;

const isEdit = mode === 'edit' && !!property;
const initialProperty = property || {
  id: '',
  title: '',
  slug: '',
  tagline: '',
  property_type: 'Single Family',
  status: 'draft',
  listing_status: 'for_sale',
  publication_status: 'published',
  price: 850000,
  bedrooms: 3,
  bathrooms: 2.0,
  square_feet: 1600,
  year_built: 2020,
  garage_spaces: 2,
  has_pool: false,
  has_spa: false,
  is_featured: false,
  is_va_eligible: true,
  is_fixer_upper: false,
  address_street: '',
  address_city: 'San Diego',
  address_state: 'CA',
  address_zip: '92101',
  neighborhood: 'North Park',
  description: '',
  primary_image: '/images/properties/north-park-spanish.svg',
  gallery_images: ['/images/properties/north-park-spanish.svg']
} as Partial<Property>;

const neighborhoods = Array.from(new Set(
  INITIAL_NEIGHBORHOODS.map(n => n.name).concat([
    'Clairemont', 'San Carlos', 'Golden Hill', 'Mission Hills', 
    'South Park', 'Downtown', 'Del Mar', 'Coronado', 'La Jolla',
    'Pacific Beach', 'Ocean Beach', 'North Park', 'Little Italy', 'Hillcrest'
  ])
)).sort();

const sampleImages = [
  { label: 'Spanish Craftsman', url: '/images/properties/north-park-spanish.svg' },
  { label: 'Coastal Modern', url: '/images/properties/la-jolla-coastal.svg' },
  { label: 'Urban Loft', url: '/images/properties/little-italy-loft.svg' },
  { label: 'Beach Duplex', url: '/images/properties/pacific-beach-duplex.svg' }
];
---

<div class="property-form-wrapper" data-mode={mode}>
  <!-- Header Bar -->
  <div class="admin-header" style="flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="font-size: 1.75rem; margin: 0 0 0.25rem 0; color: var(--admin-text-main);">
        {isEdit ? `Edit: ${initialProperty.title}` : 'Add New Property'}
      </h1>
      <p style="color: var(--admin-text-muted); margin: 0; font-size: 0.88rem;">
        {isEdit ? `Property ID: ${initialProperty.id} • /properties/${initialProperty.slug}` : 'Fill in the basic property details below and save.'}
      </p>
    </div>
    <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
      <a href="/admin/properties" class="btn btn-outline-white btn-sm">Cancel</a>
      {isEdit && (
        <a href={`/properties/${initialProperty.slug}`} target="_blank" class="btn btn-outline-white btn-sm">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px; vertical-align: -2px;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
          View on Site
        </a>
      )}
      <button type="button" id="btnSaveDraft" class="btn btn-outline-gold btn-sm">Save as Draft</button>
      <button type="button" id="btnSavePublish" class="btn btn-gold btn-sm">
        {isEdit ? 'Save Changes' : 'Save & Publish'}
      </button>
    </div>
  </div>

  <form id="simplePropertyForm" novalidate style="max-width: 900px;">
    <input type="hidden" name="id" value={initialProperty.id} />
    <input type="hidden" name="mode" value={mode} />

    <!-- 1. Basic Information -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h2 class="admin-card-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold-400)" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
          1. Basic Information
        </h2>
        <span class="badge badge-gold">Required Details</span>
      </div>

      <div class="form-group">
        <label class="form-label" for="propTitle">Property Title / Headline <span class="required">*</span></label>
        <input 
          type="text" 
          id="propTitle" 
          name="title" 
          class="form-input" 
          value={initialProperty.title} 
          placeholder="e.g. Modern Spanish Craftsman with Private Pool" 
          required 
        />
        <div class="form-hint">A clear title that buyers will see on the website.</div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="propPrice">Asking Price ($ USD) <span class="required">*</span></label>
          <input 
            type="number" 
            id="propPrice" 
            name="price" 
            class="form-input" 
            value={initialProperty.price} 
            placeholder="850000" 
            min="1000" 
            step="1000" 
            required 
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="propType">Property Type</label>
          <select id="propType" name="property_type" class="form-select">
            <option value="Single Family" selected={initialProperty.property_type === 'Single Family'}>Single Family</option>
            <option value="Condo" selected={initialProperty.property_type === 'Condo'}>Condo</option>
            <option value="Townhome" selected={initialProperty.property_type === 'Townhome'}>Townhome</option>
            <option value="Multi-Family" selected={initialProperty.property_type === 'Multi-Family'}>Multi-Family</option>
            <option value="Fixer-Upper" selected={initialProperty.property_type === 'Fixer-Upper'}>Fixer-Upper</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="propListingStatus">Listing Status</label>
          <select id="propListingStatus" name="listing_status" class="form-select">
            <option value="for_sale" selected={initialProperty.listing_status === 'for_sale'}>For Sale</option>
            <option value="pending" selected={initialProperty.listing_status === 'pending'}>Pending / Under Contract</option>
            <option value="sold" selected={initialProperty.listing_status === 'sold'}>Sold</option>
            <option value="for_rent" selected={initialProperty.listing_status === 'for_rent'}>For Rent</option>
            <option value="coming_soon" selected={initialProperty.listing_status === 'coming_soon'}>Coming Soon</option>
          </select>
        </div>
      </div>

      <div class="form-row" style="margin-top: 0.5rem;">
        <div class="form-group">
          <label class="form-label" for="propPubStatus">Publication</label>
          <select id="propPubStatus" name="publication_status" class="form-select">
            <option value="published" selected={initialProperty.publication_status === 'published'}>Published (Live on Website)</option>
            <option value="draft" selected={initialProperty.publication_status === 'draft'}>Draft (Hidden / In Preparation)</option>
          </select>
        </div>

        <div class="form-group" style="display: flex; align-items: flex-end; padding-bottom: 0.5rem;">
          <label class="form-checkbox-label" style="width: 100%;">
            <input 
              type="checkbox" 
              name="is_featured" 
              value="true" 
              checked={initialProperty.is_featured} 
            />
            <span>🌟 Feature on Homepage</span>
          </label>
        </div>
      </div>
    </div>

    <!-- 2. Location -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h2 class="admin-card-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold-400)" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          2. Location &amp; Address
        </h2>
        <span class="badge badge-blue">San Diego, CA</span>
      </div>

      <div class="form-row">
        <div class="form-group" style="flex: 2;">
          <label class="form-label" for="propStreet">Street Address</label>
          <input 
            type="text" 
            id="propStreet" 
            name="address_street" 
            class="form-input" 
            value={initialProperty.address_street} 
            placeholder="e.g. 3542 Granada Ave" 
          />
        </div>

        <div class="form-group" style="flex: 1;">
          <label class="form-label" for="propNeighborhood">Neighborhood</label>
          <select id="propNeighborhood" name="neighborhood" class="form-select">
            {neighborhoods.map(name => (
              <option value={name} selected={initialProperty.neighborhood === name}>{name}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="propCity">City</label>
          <input 
            type="text" 
            id="propCity" 
            name="address_city" 
            class="form-input" 
            value={initialProperty.address_city || 'San Diego'} 
          />
        </div>
        <div class="form-group">
          <label class="form-label" for="propState">State</label>
          <input 
            type="text" 
            id="propState" 
            name="address_state" 
            class="form-input" 
            value={initialProperty.address_state || 'CA'} 
          />
        </div>
        <div class="form-group">
          <label class="form-label" for="propZip">Zip Code</label>
          <input 
            type="text" 
            id="propZip" 
            name="address_zip" 
            class="form-input" 
            value={initialProperty.address_zip || '92101'} 
            placeholder="92101" 
          />
        </div>
      </div>
    </div>

    <!-- 3. Specs & Details -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h2 class="admin-card-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold-400)" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
          3. Property Specs &amp; Amenities
        </h2>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="propBedrooms">Bedrooms</label>
          <input 
            type="number" 
            id="propBedrooms" 
            name="bedrooms" 
            class="form-input" 
            value={initialProperty.bedrooms ?? 3} 
            min="0" 
            max="30" 
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="propBathrooms">Bathrooms</label>
          <input 
            type="number" 
            id="propBathrooms" 
            name="bathrooms" 
            class="form-input" 
            value={initialProperty.bathrooms ?? 2.0} 
            step="0.5" 
            min="0" 
            max="30" 
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="propSqFt">Square Feet</label>
          <input 
            type="number" 
            id="propSqFt" 
            name="square_feet" 
            class="form-input" 
            value={initialProperty.square_feet ?? 1500} 
            min="100" 
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="propYear">Year Built</label>
          <input 
            type="number" 
            id="propYear" 
            name="year_built" 
            class="form-input" 
            value={initialProperty.year_built ?? 2020} 
            min="1800" 
            max={new Date().getFullYear() + 1} 
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="propGarage">Garage Spaces</label>
          <input 
            type="number" 
            id="propGarage" 
            name="garage_spaces" 
            class="form-input" 
            value={initialProperty.garage_spaces ?? 2} 
            min="0" 
            max="20" 
          />
        </div>
      </div>

      <div style="margin-top: 1rem;">
        <label class="form-label">Special Features &amp; Programs</label>
        <div class="form-checkbox-row">
          <label class="form-checkbox-label">
            <input type="checkbox" name="has_pool" value="true" checked={initialProperty.has_pool} />
            <span>🏊 Swimming Pool</span>
          </label>
          <label class="form-checkbox-label">
            <input type="checkbox" name="has_spa" value="true" checked={initialProperty.has_spa} />
            <span>🛁 Spa / Hot Tub</span>
          </label>
          <label class="form-checkbox-label">
            <input type="checkbox" name="is_va_eligible" value="true" checked={initialProperty.is_va_eligible !== false} />
            <span>🎖️ VA Loan (0% Down) Eligible</span>
          </label>
          <label class="form-checkbox-label">
            <input type="checkbox" name="is_fixer_upper" value="true" checked={initialProperty.is_fixer_upper} />
            <span>🔨 Fixer-Upper / Value-Add</span>
          </label>
        </div>
      </div>
    </div>

    <!-- 4. Photos & Description -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h2 class="admin-card-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold-400)" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          4. Photos &amp; Description
        </h2>
      </div>

      <!-- Main Photo with Drag & Drop Uploader -->
      <div class="form-group">
        <label class="form-label" for="propPrimaryImage">Main Listing Photo <span class="required">*</span></label>
        
        <!-- Drag & Drop Dropzone for Primary Photo -->
        <div id="primaryDropzone" class="admin-dropzone" tabindex="0" role="button" aria-label="Drop primary image here or click to browse">
          <div class="dropzone-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
          </div>
          <div class="dropzone-title">Drag &amp; drop primary photo here, or <span style="color: var(--color-gold-700); text-decoration: underline;">browse files</span></div>
          <div class="dropzone-subtitle">Drop any image directly from your computer (JPG, PNG, WEBP, SVG)</div>
          <input type="file" id="primaryFileInput" accept="image/jpeg,image/png,image/webp,image/svg+xml" style="display: none;" />
          <div id="primaryUploadStatus" class="dropzone-status" style="display: none;"></div>
        </div>

        <div style="display: flex; gap: 1rem; align-items: flex-start; flex-wrap: wrap; margin-top: 1rem;">
          <div style="flex: 1; min-width: 250px;">
            <label class="form-label" style="font-size: 0.8rem; margin-bottom: 0.25rem;">Active Image URL</label>
            <input 
              type="text" 
              id="propPrimaryImage" 
              name="primary_image" 
              class="form-input" 
              value={initialProperty.primary_image || '/images/properties/north-park-spanish.svg'} 
              placeholder="/images/properties/north-park-spanish.svg or /uploads/..." 
            />
            <div class="form-hint" style="margin-top: 0.35rem; margin-bottom: 0.5rem;">
              Or select one of the quick starter presets:
            </div>
            <!-- Quick Preset Photos -->
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
              {sampleImages.map(sample => (
                <button 
                  type="button" 
                  class="btn btn-outline-white btn-sm btn-quick-image" 
                  data-url={sample.url}
                  style="font-size: 0.75rem; padding: 0.3rem 0.6rem;"
                >
                  {sample.label}
                </button>
              ))}
            </div>
          </div>
          <!-- Live Preview -->
          <div style="width: 140px; height: 95px; background: #0f172a; border-radius: 6px; overflow: hidden; border: 1px solid var(--admin-border); flex-shrink: 0; display: flex; align-items: center; justify-content: center; box-shadow: var(--shadow-sm);">
            <img 
              id="previewImg" 
              src={initialProperty.primary_image || '/images/properties/north-park-spanish.svg'} 
              alt="Listing preview" 
              style="width: 100%; height: 100%; object-fit: cover;" 
            />
          </div>
        </div>
      </div>

      <!-- Tagline -->
      <div class="form-group">
        <label class="form-label" for="propTagline">Short Tagline (Optional)</label>
        <input 
          type="text" 
          id="propTagline" 
          name="tagline" 
          class="form-input" 
          value={initialProperty.tagline || ''} 
          placeholder="e.g. Rare architectural find with entertainer's courtyard" 
        />
      </div>

      <!-- Full Description -->
      <div class="form-group">
        <label class="form-label" for="propDescription">Property Description</label>
        <textarea 
          id="propDescription" 
          name="description" 
          class="form-textarea" 
          rows="5"
          placeholder="Describe the property features, neighborhood vibes, kitchen, yard, and architectural highlights..."
        >{initialProperty.description || ''}</textarea>
      </div>

      <!-- Additional Gallery Images with Drag & Drop -->
      <div class="form-group">
        <label class="form-label">Additional Gallery Photos</label>
        
        <!-- Multi-File Drag & Drop Zone -->
        <div id="galleryDropzone" class="admin-dropzone" tabindex="0" role="button" aria-label="Drop gallery photos here or click to browse">
          <div class="dropzone-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          </div>
          <div class="dropzone-title">Drag &amp; drop multiple gallery photos here, or <span style="color: var(--color-gold-700); text-decoration: underline;">browse</span></div>
          <div class="dropzone-subtitle">Drop multiple photos at once to build your listing photo gallery</div>
          <input type="file" id="galleryFileInput" accept="image/jpeg,image/png,image/webp,image/svg+xml" multiple style="display: none;" />
          <div id="galleryUploadStatus" class="dropzone-status" style="display: none;"></div>
        </div>

        <!-- Visual Thumbnail Strip -->
        <div id="galleryThumbnailsContainer" class="admin-gallery-strip"></div>

        <textarea 
          id="propGallery" 
          name="gallery_text" 
          class="form-textarea" 
          rows="2"
          style="margin-top: 0.75rem; font-family: monospace; font-size: 0.82rem;"
          placeholder="Paste additional image URLs (one per line) or use drag & drop above"
        >{(initialProperty.gallery_images || []).join('\n')}</textarea>
        <div class="form-hint">Gallery photos list synchronizes automatically with the thumbnails above.</div>
      </div>
    </div>

    <!-- Bottom Actions -->
    <div style="display: flex; gap: 1rem; align-items: center; justify-content: flex-end; padding: 1.5rem 0; margin-bottom: 3rem;">
      <a href="/admin/properties" class="btn btn-outline-white">Cancel</a>
      <button type="button" id="btnSaveDraftBottom" class="btn btn-outline-gold">Save as Draft</button>
      <button type="button" id="btnSavePublishBottom" class="btn btn-gold btn-lg">
        {isEdit ? '💾 Save Changes' : '✅ Save & Publish'}
      </button>
    </div>
  </form>

  <!-- Notification Toast Container -->
  <div id="formToast" class="admin-toast-container"></div>
</div>

<script>
  function setupSimplePropertyForm() {
    const form = document.getElementById('simplePropertyForm') as HTMLFormElement;
    if (!form) return;

    const primaryImageInput = document.getElementById('propPrimaryImage') as HTMLInputElement;
    const previewImg = document.getElementById('previewImg') as HTMLImageElement;
    const toastContainer = document.getElementById('formToast');
    const galleryTextarea = document.getElementById('propGallery') as HTMLTextAreaElement;
    const galleryThumbnailsContainer = document.getElementById('galleryThumbnailsContainer');

    // Helper: show toast message
    function showToast(msg: string, type: 'success' | 'error' = 'success') {
      if (!toastContainer) {
        alert(msg);
        return;
      }
      const toast = document.createElement('div');
      toast.className = `admin-toast ${type}`;
      toast.textContent = msg;
      toastContainer.appendChild(toast);
      setTimeout(() => toast.remove(), 4000);
    }

    // Live primary image preview on input typing
    if (primaryImageInput && previewImg) {
      primaryImageInput.addEventListener('input', () => {
        const val = primaryImageInput.value.trim();
        if (val) previewImg.src = val;
      });
    }

    // Quick image preset buttons
    document.querySelectorAll('.btn-quick-image').forEach(btn => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-url');
        if (url && primaryImageInput && previewImg) {
          primaryImageInput.value = url;
          previewImg.src = url;
        }
      });
    });

    // Helper: Upload file to /api/admin/media/upload
    async function uploadMediaFile(file: File): Promise<string> {
      const formData = new FormData();
      formData.append('file', file);
      const res = await fetch('/api/admin/media/upload', {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Upload failed');
      }
      return data.mediaUrl;
    }

    // 1. Primary Image Dropzone Setup
    const primaryDropzone = document.getElementById('primaryDropzone');
    const primaryFileInput = document.getElementById('primaryFileInput') as HTMLInputElement;
    const primaryUploadStatus = document.getElementById('primaryUploadStatus');

    if (primaryDropzone && primaryFileInput) {
      // Click or keyboard trigger
      primaryDropzone.addEventListener('click', () => primaryFileInput.click());
      primaryDropzone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          primaryFileInput.click();
        }
      });

      // Drag events
      ['dragenter', 'dragover'].forEach(eventName => {
        primaryDropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          primaryDropzone.classList.add('drag-over');
        });
      });

      ['dragleave', 'drop'].forEach(eventName => {
        primaryDropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          primaryDropzone.classList.remove('drag-over');
        });
      });

      // Handle drop
      primaryDropzone.addEventListener('drop', async (e) => {
        const files = e.dataTransfer?.files;
        if (files && files.length > 0) {
          await handlePrimaryFileUpload(files[0]);
        }
      });

      // Handle file input selection
      primaryFileInput.addEventListener('change', async () => {
        if (primaryFileInput.files && primaryFileInput.files.length > 0) {
          await handlePrimaryFileUpload(primaryFileInput.files[0]);
        }
      });

      async function handlePrimaryFileUpload(file: File) {
        if (!primaryUploadStatus) return;
        primaryUploadStatus.style.display = 'block';
        primaryUploadStatus.className = 'dropzone-status uploading';
        primaryUploadStatus.textContent = `Uploading ${file.name}...`;

        try {
          const mediaUrl = await uploadMediaFile(file);
          if (primaryImageInput) primaryImageInput.value = mediaUrl;
          if (previewImg) previewImg.src = mediaUrl;
          primaryUploadStatus.className = 'dropzone-status success';
          primaryUploadStatus.textContent = `✓ Uploaded: ${file.name}`;
          showToast('Primary photo uploaded successfully!', 'success');
        } catch (err: any) {
          primaryUploadStatus.className = 'dropzone-status error';
          primaryUploadStatus.textContent = `✕ Error: ${err.message}`;
          showToast(`Upload error: ${err.message}`, 'error');
        }
      }
    }

    // 2. Gallery Images Multi-File Dropzone & Thumbnail Strip
    const galleryDropzone = document.getElementById('galleryDropzone');
    const galleryFileInput = document.getElementById('galleryFileInput') as HTMLInputElement;
    const galleryUploadStatus = document.getElementById('galleryUploadStatus');

    function getGalleryUrls(): string[] {
      if (!galleryTextarea) return [];
      return galleryTextarea.value
        .split('\n')
        .map(l => l.trim())
        .filter(Boolean);
    }

    function setGalleryUrls(urls: string[]) {
      if (galleryTextarea) {
        galleryTextarea.value = urls.join('\n');
      }
      renderGalleryThumbnails(urls);
    }

    function renderGalleryThumbnails(urls: string[]) {
      if (!galleryThumbnailsContainer) return;
      galleryThumbnailsContainer.innerHTML = '';
      urls.forEach((url, index) => {
        const item = document.createElement('div');
        item.className = 'gallery-thumb-item';

        const img = document.createElement('img');
        img.src = url;
        img.alt = `Gallery ${index + 1}`;

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'gallery-thumb-remove';
        removeBtn.innerHTML = '&times;';
        removeBtn.title = 'Remove photo';
        removeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const currentUrls = getGalleryUrls();
          currentUrls.splice(index, 1);
          setGalleryUrls(currentUrls);
        });

        item.appendChild(img);
        item.appendChild(removeBtn);
        galleryThumbnailsContainer.appendChild(item);
      });
    }

    // Initial render of existing gallery images
    renderGalleryThumbnails(getGalleryUrls());

    // Update thumbnails when textarea is edited directly
    galleryTextarea?.addEventListener('input', () => {
      renderGalleryThumbnails(getGalleryUrls());
    });

    if (galleryDropzone && galleryFileInput) {
      galleryDropzone.addEventListener('click', () => galleryFileInput.click());
      galleryDropzone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          galleryFileInput.click();
        }
      });

      ['dragenter', 'dragover'].forEach(eventName => {
        galleryDropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          galleryDropzone.classList.add('drag-over');
        });
      });

      ['dragleave', 'drop'].forEach(eventName => {
        galleryDropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          galleryDropzone.classList.remove('drag-over');
        });
      });

      galleryDropzone.addEventListener('drop', async (e) => {
        const files = e.dataTransfer?.files;
        if (files && files.length > 0) {
          await handleGalleryFiles(Array.from(files));
        }
      });

      galleryFileInput.addEventListener('change', async () => {
        if (galleryFileInput.files && galleryFileInput.files.length > 0) {
          await handleGalleryFiles(Array.from(galleryFileInput.files));
        }
      });

      async function handleGalleryFiles(files: File[]) {
        if (!galleryUploadStatus) return;
        galleryUploadStatus.style.display = 'block';
        galleryUploadStatus.className = 'dropzone-status uploading';
        galleryUploadStatus.textContent = `Uploading ${files.length} photo(s)...`;

        const newUrls: string[] = [];
        let errors = 0;

        for (const file of files) {
          try {
            const url = await uploadMediaFile(file);
            newUrls.push(url);
          } catch (e: any) {
            errors++;
            console.error('File upload failed for', file.name, e);
          }
        }

        const currentUrls = getGalleryUrls();
        const merged = Array.from(new Set([...currentUrls, ...newUrls]));
        setGalleryUrls(merged);

        if (errors === 0) {
          galleryUploadStatus.className = 'dropzone-status success';
          galleryUploadStatus.textContent = `✓ Successfully added ${newUrls.length} photo(s)!`;
          showToast(`Added ${newUrls.length} photo(s) to gallery.`, 'success');
        } else {
          galleryUploadStatus.className = 'dropzone-status error';
          galleryUploadStatus.textContent = `Uploaded ${newUrls.length} photo(s), ${errors} failed.`;
          showToast(`Uploaded ${newUrls.length} photo(s), but ${errors} failed.`, 'error');
        }
      }
    }

    // 3. Form Submission
    async function submitForm(targetStatus: 'draft' | 'published') {
      const titleInput = document.getElementById('propTitle') as HTMLInputElement;
      const priceInput = document.getElementById('propPrice') as HTMLInputElement;

      const title = titleInput?.value.trim() || '';
      const price = parseFloat(priceInput?.value || '0');

      if (!title || title.length < 3) {
        showToast('Please enter a property title (minimum 3 characters).', 'error');
        titleInput?.focus();
        return;
      }

      if (!price || price <= 0) {
        showToast('Please enter a valid asking price greater than 0.', 'error');
        priceInput?.focus();
        return;
      }

      const fd = new FormData(form);
      const mode = fd.get('mode') as string;
      const id = fd.get('id') as string;

      // Gallery images array
      const galleryRaw = (fd.get('gallery_text') as string || '').trim();
      const galleryLines = galleryRaw ? galleryRaw.split('\n').map(l => l.trim()).filter(Boolean) : [];
      const primaryImg = (fd.get('primary_image') as string || '').trim() || '/images/properties/north-park-spanish.svg';
      const gallery_images = [primaryImg, ...galleryLines.filter(u => u !== primaryImg)];

      const payload: any = {
        title,
        price,
        property_type: fd.get('property_type') || 'Single Family',
        listing_status: fd.get('listing_status') || 'for_sale',
        publication_status: targetStatus,
        status: targetStatus === 'published' ? 'active' : 'draft',
        is_featured: fd.get('is_featured') === 'true',
        address_street: fd.get('address_street') || '123 Main St',
        neighborhood: fd.get('neighborhood') || 'North Park',
        address_city: fd.get('address_city') || 'San Diego',
        address_state: fd.get('address_state') || 'CA',
        address_zip: fd.get('address_zip') || '92101',
        bedrooms: parseInt(fd.get('bedrooms') as string || '3', 10),
        bathrooms: parseFloat(fd.get('bathrooms') as string || '2.0'),
        square_feet: parseInt(fd.get('square_feet') as string || '1500', 10),
        year_built: parseInt(fd.get('year_built') as string || '2020', 10),
        garage_spaces: parseInt(fd.get('garage_spaces') as string || '2', 10),
        has_pool: fd.get('has_pool') === 'true',
        has_spa: fd.get('has_spa') === 'true',
        is_va_eligible: fd.get('is_va_eligible') === 'true',
        is_fixer_upper: fd.get('is_fixer_upper') === 'true',
        tagline: fd.get('tagline') || '',
        description: fd.get('description') || '',
        primary_image: primaryImg,
        gallery_images
      };

      if (mode === 'edit' && id) {
        payload.id = id;
      }

      const isEdit = mode === 'edit';
      const endpoint = '/api/admin/properties';
      const method = isEdit ? 'PUT' : 'POST';

      // Disable buttons during submission
      const allButtons = form.querySelectorAll('button');
      allButtons.forEach(b => (b as HTMLButtonElement).disabled = true);

      try {
        const res = await fetch(endpoint, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (res.ok && data.success) {
          showToast(`Property successfully ${isEdit ? 'updated' : 'created'}! Redirecting...`, 'success');
          setTimeout(() => {
            window.location.href = '/admin/properties';
          }, 1000);
        } else {
          showToast(data.error || 'Failed to save property.', 'error');
          allButtons.forEach(b => (b as HTMLButtonElement).disabled = false);
        }
      } catch (err: any) {
        showToast('Network error: ' + err.message, 'error');
        allButtons.forEach(b => (b as HTMLButtonElement).disabled = false);
      }
    }

    // Attach click events
    document.getElementById('btnSaveDraft')?.addEventListener('click', () => submitForm('draft'));
    document.getElementById('btnSaveDraftBottom')?.addEventListener('click', () => submitForm('draft'));
    document.getElementById('btnSavePublish')?.addEventListener('click', () => submitForm('published'));
    document.getElementById('btnSavePublishBottom')?.addEventListener('click', () => submitForm('published'));
  }

  // Setup on page load
  document.addEventListener('astro:page-load', setupSimplePropertyForm);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setupSimplePropertyForm();
  }
</script>
