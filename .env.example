# Edgar Valle Real Estate Platform - Environment Configuration

# Public Supabase API Settings (browser & server safe)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Private Supabase Admin Service Key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin Portal Authentication Secret / Session Token
ADMIN_SECRET_KEY=edgar-valle-admin-session-secure-key-2026
SESSION_SECRET=edgar-valle-admin-session-secure-key-2026 # Alternative alias for ADMIN_SECRET_KEY

# Real-Time Lead Notification Webhook (Optional - Zapier, Slack, or CRM)
LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your-id/

# Site Production URL
SITE_URL=https://edgarvalle.com

# Node Environment
NODE_ENV=production

# Google Search Console API (Optional for verified SEO Analytics)
GSC_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GSC_SITE_URL=https://edgarvalle.com
